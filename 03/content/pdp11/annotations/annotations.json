    },
    {
      "id": "lamp_addr_group_role",
      "type": "role",
      "target": "lamp_addr_group",
      "text": "地址灯组在整机中以一排指示灯显示当前地址总线的值，供操作员观察程序执行位置。"
    },
    {
      "id": "lamp_data_group_role",
      "type": "role",
      "target": "lamp_data_group",
      "text": "数据灯组在整机中以一排指示灯显示当前数据总线的值，供操作员观察数据流动。"
    },
    {
