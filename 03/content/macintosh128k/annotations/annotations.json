    {
      "id": "ad_1984",
      "type": "flow",
      "target": "whole",
      "text": "1984 年超级碗广告以乔治·奥威尔《1984》为隐喻，宣告 Macintosh 将打破 IBM 的统治，是广告史与科技史的经典时刻。"
    },
    {
      "id": "signature_wall_story",
      "type": "flow",
      "target": "signature_wall",
      "text": "1982 年 Macintosh 团队成员把签名铸进机壳内壁模具，只有拆开机器的人才能看到——这是工程师文化最浪漫的注脚。"
    },
    {
      "id": "happy_mac",
      "type": "flow",
      "target": "crt_tube",
      "text": "开机时屏幕上出现的笑脸图标「Happy Mac」宣告系统启动成功，是无数 Mac 用户最初的记忆。"
    },
    {
      "id": "raskin_origin",
      "type": "flow",
      "target": "whole",
      "text": "项目由 Jef Raskin 发起，他提出「为大众造一台便宜易用的电脑」，并把它命名为 Macintosh。"
    },
    {
      "id": "jobs_takeover",
      "type": "flow",
      "target": "whole",
      "text": "史蒂夫·乔布斯 1981 年接手 Macintosh 项目，注入了对图形界面与工业设计的极致追求。"
    },
    {
      "id": "gui_demo",
      "type": "flow",
      "target": "whole",
      "text": "Macintosh 用「桌面、窗口、图标、菜单」四位一体的图形界面，让普通人不学命令也能操作电脑。"
    },
    {
      "id": "mouse_intro",
      "type": "flow",
      "target": "mouse",
      "text": "Macintosh 让鼠标第一次成为大众电脑的标配，改变了人与机器的交互方式。"
    },
    {
      "id": "desktop_publishing",
      "type": "flow",
      "target": "whole",
      "text": "Macintosh 配合 LaserWriter 激光打印机，催生了桌面出版革命，改变了印刷与出版行业。"
    },
    {
      "id": "font_system",
      "type": "flow",
      "target": "crt_tube",
      "text": "Macintosh 首次在消费级电脑上呈现所见即所得的多字体排版，为文字处理树立新标准。"
    },
    {
      "id": "floppy_400k",
      "type": "flow",
      "target": "floppy_drive",
      "text": "3.5 英寸 400KB 软驱取代了当时主流的 5.25 英寸软驱，成为更便携可靠的存储标准。"
    },
    {
      "id": "no_arrow_keys",
      "type": "flow",
      "target": "keyboard",
      "text": "键盘刻意省去方向键，是乔布斯逼迫用户改用鼠标的设计决策，至今仍是设计史谈资。"
    },
    {
      "id": "macwrite_macpaint",
      "type": "flow",
      "target": "whole",
      "text": "随附的 MacWrite 与 MacPaint 首次把所见即所得文字处理与位图绘画带给大众。"
