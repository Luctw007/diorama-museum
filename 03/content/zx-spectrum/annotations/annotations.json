    {
      "id": "bedroom_coding",
      "type": "flow",
      "target": "whole",
      "text": "卧室编程文化：无数英国青少年在卧室里用 Spectrum 自学 BASIC 并创作游戏，催生了独立的游戏开发一代。"
    },
    {
      "id": "rainbow_stripe",
      "type": "flow",
      "target": "rainbow_stripe",
      "text": "彩虹条纹讲解：机身右侧的红黄绿青四色条纹，是 Spectrum 与生俱来的品牌视觉符号。"
    },
    {
      "id": "tape_load",
      "type": "flow",
      "target": "ula_chip",
      "text": "磁带载入讲解：程序经 ULA 从磁带读入时发出尖锐的「吱吱」声，屏幕边缘闪动彩色条纹，是那一代用户的共同记忆。"
    },
    {
      "id": "keyword_system",
      "type": "flow",
      "target": "keyboard",
      "text": "keyword 录入讲解：每个按键对应一个 BASIC 关键字，按一下即整词录入，省去逐字输入的繁琐。"
    },
    {
      "id": "peripheral_era",
      "type": "flow",
      "target": "expansion_port",
      "text": "外设扩展讲解：通过边框扩展口可接 ZX Printer、Interface 1 与微驱，开启 Spectrum 的外设生态。"
    },
    {
      "id": "colour_clash",
      "type": "flow",
      "target": "ula_chip",
      "text": "色彩冲突讲解：受限于 ULA，每个 8×8 字符块只能使用两种颜色，形成了 Spectrum 独特的「色彩冲突」画面风格。"
    },
    {
      "id": "rubber_key_feel",
      "type": "flow",
      "target": "rubber_key_matrix",
      "text": "橡胶键盘讲解：整块橡胶膜覆盖的 40 个按键，按下去软而回弹，是 Spectrum 最独特的触感记忆。"
    },
    {
      "id": "spectrum_games",
      "type": "flow",
      "target": "whole",
      "text": "游戏生态讲解：Spectrum 的海量游戏催生了独立的英国游戏开发场景，无数经典至今仍被玩家铭记。"
    },
    {
      "id": "clone_ecosystem",
      "type": "flow",
      "target": "whole",
      "text": "克隆生态讲解：Spectrum 的简单架构催生了苏联与东欧的大量兼容克隆机，影响跨越铁幕。"
    },
    {
      "id": "sinclair_legacy",
      "type": "flow",
      "target": "whole",
      "text": "辛克莱传奇讲解：克立夫·辛克莱以极低价格策略让电脑走进英国普通家庭，是个人计算普及的先驱。"
    },
    {
      "id": "z80_era",
      "type": "flow",
      "target": "cpu_z80",
      "text": "Z80 时代讲解：Z80 是 8 位时代最普及的 CPU 之一，Spectrum 让它成为整整一代程序员的启蒙芯片。"
    },
    {
      "id": "colour_attr",
      "type": "flow",
      "target": "ula_chip",
      "text": "色彩属性讲解：每个字符块的颜色由独立的属性字节控制，造就了 Spectrum 高效而受限的色彩方案。"
    },
    {
      "id": "basic_env",
      "type": "flow",
      "target": "rom",
      "text": "BASIC 环境讲解：开机即进入 Sinclair BASIC，无需磁盘与操作系统，是最直接的编程启蒙环境。"
    }
