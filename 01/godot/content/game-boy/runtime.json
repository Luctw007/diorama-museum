{
  "emulator": "sameboy",
  "version": "0.16",
  "system": "gameboy",
  "media_hint": "cartridge",
  "bios_required": false,
  "bios_guide_url": null,
  "output_sinks": [
    {
      "id": "lcd_internal",
      "surface": "handheld_lcd",
      "type": "video",
      "format": "rgba8"
    },
    {
      "id": "speaker_0",
      "surface": "speaker",
      "type": "audio",
      "format": "pcm16"
    },
    {
      "id": "led_power",
      "surface": "led",
      "type": "hid"
    }
  ],
  "input_map": {
    "pad_up": {
      "map": "joystick",
      "key": "hat_0"
    },
    "pad_down": {
      "map": "joystick",
      "key": "hat_0"
    },
    "pad_left": {
      "map": "joystick",
      "key": "hat_0"
    },
    "pad_right": {
      "map": "joystick",
      "key": "hat_0"
    },
    "btn_a": {
      "map": "joystick",
      "key": "btn0"
    },
    "btn_b": {
      "map": "joystick",
      "key": "btn1"
    },
    "btn_start": {
      "map": "keyboard",
      "key": "KEY_ENTER"
    },
    "btn_select": {
      "map": "keyboard",
      "key": "KEY_RSHIFT"
    },
    "power": {
      "map": "keyboard",
      "key": "KEY_POWER"
    }
  }
