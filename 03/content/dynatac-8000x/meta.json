  "meta": {
    "id": "dynatac-8000x",
    "name": {
      "zh": "Motorola DynaTAC 8000X",
      "en": "Motorola DynaTAC 8000X"
    },
    "intro": {
      "zh": "Motorola DynaTAC 8000X 是 1983 年获 FCC 批准的首台商用便携式蜂窝移动电话，俗称「大哥大」「砖头机」，重近 1 公斤、售价 3995 美元，开启个人无线通讯时代。",
      "en": "The Motorola DynaTAC 8000X, FCC-approved in 1983, was the first commercial handheld cellular phone, nicknamed the brick, weighing almost 1 kg and costing US$3,995."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1983,
    "manufacturer": "Motorola",
    "category": "phone",
    "description": "Motorola DynaTAC 8000X（1983）：首台商用手持蜂窝移动电话，1G 模拟 AMPS 网络，近 1kg，通话约 30 分钟，售价 3995 美元。演示向（无成熟模拟器）。",
