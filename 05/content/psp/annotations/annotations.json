{
  "annotations": [
    {"id": "chassis_role", "type": "role", "target": "chassis", "text": "横置宽屏机身是 PlayStation Portable 整机主体，在整机中承载屏幕、按键与 UMD 光盘仓等部件，是横置宽屏握持的识别件。", "sources": []},
    {"id": "screen_role", "type": "role", "target": "screen", "text": "屏幕在整机中位于正面中央，采用 4.3 英寸宽屏显示游戏与多媒体画面，是掌机的显示核心。", "sources": []},
    {"id": "umd_drive_role", "type": "role", "target": "umd_drive", "text": "UMD 光盘仓在整机中位于背部，装载 UMD 光盘介质，是可开合的光盘仓识别件。", "sources": []},
    {"id": "control_buttons_role", "type": "role", "target": "control_buttons", "text": "按键区在整机中位于正面，含十字键、△○×□ 键与摇杆，是掌机的主要操作输入。", "sources": []},
    {"id": "shoulder_buttons_role", "type": "role", "target": "shoulder_buttons", "text": "肩键区在整机中位于顶部两侧，L/R 肩键为横置握持提供额外输入。", "sources": []},
    {"id": "battery_compartment_role", "type": "role", "target": "battery_compartment", "text": "电池仓在整机中位于底部，装载电池为掌机供电，保障便携续航。", "sources": []},
    {"id": "mips_cpu_role", "type": "role", "target": "mips_cpu", "text": "MIPS CPU 在整机中执行游戏逻辑与系统运算，采用双核架构，是整机的运算核心。", "sources": []},
    {"id": "gpu_role", "type": "role", "target": "gpu", "text": "GPU 在整机中负责图形渲染，绘制宽屏游戏画面，是整机的图形处理核心。", "sources": []},
    {"id": "ram_role", "type": "role", "target": "ram", "text": "主内存芯片在整机中提供工作内存，暂存运行时的程序与图形数据。", "sources": []},
    {"id": "umd_motor_role", "type": "role", "target": "umd_motor", "text": "UMD 电机在整机中驱动光盘旋转，配合读取机构完成数据读取，是光驱的动力核心。", "sources": []},
    {"id": "dpad_role", "type": "role", "target": "control_buttons", "text": "十字键在整机中位于按键区左侧，提供八方向输入，是掌机的主要方向控制。", "sources": []},
    {"id": "face_buttons_role", "type": "role", "target": "control_buttons", "text": "△○×□ 键在整机中位于按键区右侧，是 PSP 标志性的动作按键布局。", "sources": []},
    {"id": "analog_stick_role", "type": "role", "target": "control_buttons", "text": "摇杆在整机中位于按键区下方，提供模拟方向输入，增强 3D 游戏操控。", "sources": []},
    {"id": "speaker_role", "type": "role", "target": "chassis", "text": "扬声器在整机中位于机身正面两侧，播放游戏音效与多媒体声音。", "sources": []},
    {"id": "widescreen_role", "type": "role", "target": "screen", "text": "宽屏屏幕在整机中呈现 16:9 游戏画面，是 PSP 相较任天堂掌机的显示优势。", "sources": []},
    {"id": "umd_media_role", "type": "role", "target": "umd_drive", "text": "UMD 光盘在整机中作为游戏与影音介质，装载于光盘仓内由主机读取。", "sources": []},
    {"id": "landscape_flow", "type": "flow", "target": "chassis", "text": "横置造型：PSP 采用横置宽屏机身，十字键左、△○×□ 右，是索尼掌机横置握持的代表形态。", "sources": []},
    {"id": "umd_load_flow", "type": "flow", "target": "umd_drive", "text": "UMD 装载：打开背部光盘仓放入 UMD 光盘，合盖后主机读取光盘启动游戏。", "sources": []},
    {"id": "screen_flow", "type": "flow", "target": "screen", "text": "宽屏显示：4.3 英寸宽屏让 PSP 得以呈现接近家用机的宽屏画面。", "sources": []},
    {"id": "buttons_flow", "type": "flow", "target": "control_buttons", "text": "按键操作：十字键与 △○×□ 键为玩家提供完整的动作与方向输入。", "sources": []},
    {"id": "shoulder_flow", "type": "flow", "target": "shoulder_buttons", "text": "肩键操作：L/R 肩键为横置握持下的食指提供额外输入。", "sources": []},
    {"id": "battery_flow", "type": "flow", "target": "battery_compartment", "text": "电池供电：电池仓装载电池，为掌机提供便携续航。", "sources": []},
    {"id": "multimedia_flow", "type": "flow", "target": "chassis", "text": "多媒体定位：PSP 除游戏外还可播放影音与音乐，是索尼多媒体掌机的定位。", "sources": []},
    {"id": "performance_flow", "type": "flow", "target": "chassis", "text": "性能跃升：MIPS 双核与 GPU 让 PSP 性能接近当时家用机水准。", "sources": []},
    {"id": "cpu_flow", "type": "flow", "target": "mips_cpu", "text": "主运算：MIPS 双核 CPU 执行游戏逻辑与系统任务，是性能核心。", "sources": []},
    {"id": "gpu_flow", "type": "flow", "target": "gpu", "text": "图形渲染：GPU 绘制宽屏游戏画面，保证流畅的 3D 表现。", "sources": []},
    {"id": "memory_flow", "type": "flow", "target": "ram", "text": "内存暂存：主内存芯片暂存运行数据，支撑游戏与多媒体的流畅运行。", "sources": []},
    {"id": "motor_flow", "type": "flow", "target": "umd_motor", "text": "光盘驱动：UMD 电机旋转光盘，配合读取机构完成数据读取。", "sources": []},
    {"id": "umd_open_anim", "type": "anim", "target": "umd_drive", "text": "UMD 仓开合动画：打开背部 UMD 光盘仓、放入光盘后合盖开机；单次全程约 3 秒。", "sources": []},
    {"id": "boot_anim", "type": "anim", "target": "chassis", "text": "开机动画：按下电源键，宽屏屏幕点亮并进入系统启动画面；全程约 3 秒。", "sources": []}
  ]
}
