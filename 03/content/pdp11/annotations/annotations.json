    },
    {
      "id": "sw_clear_role",
      "type": "role",
      "target": "sw_clear",
      "text": "清除开关在整机中清除寄存器和显示，使机器回到空白状态。"
    },
    {
      "id": "sw_power_role",
      "type": "role",
