      "name": "锂离子电池",
      "type": "battery",
      "role": {
        "zh": "锂离子电池在整机中储存电能，为整机供电，且为不可拆卸的内置设计。"
      },
      "assembly": "battery",
      "annotations": [
        "battery_cell_role"
      ]
    },
    {
