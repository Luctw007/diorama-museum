  "components": [
    {
      "id": "cpu_8088",
      "name": "8088 处理器",
      "type": "cpu",
      "role": {
        "zh": "8088 处理器在整机中作为计算核心，16 位内部、8 位外部数据总线，主频 4.77 MHz。"
      },
      "assembly": "motherboard",
      "annotations": [
        "cpu_8088_role"
      ]
    },
    {
      "id": "bios_rom",
      "name": "BIOS ROM",
      "type": "rom",
      "role": {
        "zh": "BIOS ROM 在整机中固化开机自检、引导与硬件抽象层，是 IBM 兼容机标准的技术基石。"
      },
      "assembly": "motherboard",
      "annotations": [
        "bios_rom_role"
      ]
    },
    {
      "id": "ram",
      "name": "内存（16–64KB）",
      "type": "ram",
      "role": {
        "zh": "内存在整机中存放程序与数据，是系统运行时的主存储，可通过扩展卡扩充。"
      },
      "assembly": "motherboard",
      "annotations": [
        "ram_role"
      ]
    },
    {
      "id": "isa_slot",
      "name": "ISA 扩展槽",
      "type": "slot",
      "role": {
        "zh": "ISA 扩展槽在整机中提供 8 位开放总线插槽，供第三方扩展卡接入，是开放架构的核心。"
      },
      "assembly": "motherboard",
      "annotations": [
        "isa_slot_role"
      ]
    },
    {
      "id": "dma_8237",
      "name": "8237 DMA 控制器",
      "type": "controller",
      "role": {
        "zh": "8237 DMA 控制器在整机中管理外设与内存之间的直接数据传送，减轻 CPU 负担。"
      },
      "assembly": "motherboard",
      "annotations": [
        "dma_8237_role"
      ]
    },
    {
      "id": "pic_8259",
      "name": "8259 中断控制器",
      "type": "controller",
      "role": {
        "zh": "8259 中断控制器在整机中管理硬件中断的优先级与分发，协调 CPU 响应外设请求。"
      },
      "assembly": "motherboard",
      "annotations": [
        "pic_8259_role"
      ]
    },
    {
      "id": "pit_8253",
      "name": "8253 定时器",
      "type": "timer",
      "role": {
        "zh": "8253 定时器在整机中产生系统节拍与定时信号，是内存刷新与计时的基础。"
      },
      "assembly": "motherboard",
      "annotations": [
        "pit_8253_role"
      ]
    },
    {
      "id": "coprocessor_socket",
      "name": "8087 协处理器插座",
      "type": "socket",
      "role": {
        "zh": "8087 协处理器插座在整机中用于安装浮点协处理器，为科学计算提供硬件浮点加速。"
      },
      "assembly": "motherboard",
      "annotations": [
        "coprocessor_socket_role"
      ]
    },
    {
