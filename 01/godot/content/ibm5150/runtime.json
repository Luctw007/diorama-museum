{
  "emulator": "pc86box",
  "version": "5.1.0",
  "system": "IBM PC 5150",
  "media_hint": "floppy",
  "bios_required": false,
  "bios_guide_url": null,
  "output_sinks": [
    {
      "id": "external_crt_0",
      "surface": "external_crt",
      "type": "video",
      "format": "mono1"
    },
    {
      "id": "terminal_0",
      "surface": "terminal",
      "type": "video",
      "format": "text"
    },
    {
      "id": "speaker_0",
      "surface": "speaker",
      "type": "audio",
      "format": "pcm16"
    },
    {
      "id": "led_0",
      "surface": "led",
      "type": "video",
      "format": "mono1"
    }
  ],
  "input_map": {
    "power": {
      "map": "keyboard",
      "key": "KEY_POWER"
    },
    "reset": {
      "map": "keyboard",
      "key": "KEY_RESET"
    },
    "enter": {
      "map": "keyboard",
      "key": "KEY_ENTER"
    },
    "escape": {
      "map": "keyboard",
      "key": "KEY_ESCAPE"
    },
    "space": {
      "map": "keyboard",
      "key": "KEY_SPACE"
    },
    "ctrl": {
      "map": "keyboard",
      "key": "KEY_CTRL"
    },
    "alt": {
      "map": "keyboard",
      "key": "KEY_ALT"
    }
  }
}
