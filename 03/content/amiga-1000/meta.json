      "name": "键盘按键",
      "type": "key",
      "role": {
        "zh": "键盘按键在整机中接收字符输入，把按键转换为电信号送入主板，是文字输入的核心部件。"
      },
      "assembly": "keyboard",
      "annotations": [
        "keyboard_keys_role"
      ]
