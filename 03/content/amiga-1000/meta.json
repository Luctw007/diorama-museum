  "components": [
    {
      "id": "cpu_68000",
      "name": "68000 处理器",
      "type": "cpu",
      "role": {
        "zh": "68000 处理器在整机中作为 16/32 位中央处理器，执行取指、译码与运算，是机器的运算核心。"
      },
      "assembly": "motherboard",
      "annotations": [
        "cpu_68000_role"
      ]
    },
    {
      "id": "agnus",
      "name": "Agnus 芯片",
      "type": "chip",
      "role": {
        "zh": "Agnus 芯片在整机中负责内存与总线控制，协调各芯片对内存的访问，是三芯片组的中枢。"
      },
      "assembly": "motherboard",
      "annotations": [
        "agnus_role"
      ]
    },
    {
      "id": "denise",
      "name": "Denise 芯片",
      "type": "chip",
      "role": {
        "zh": "Denise 芯片在整机中负责图形输出，生成彩色画面与硬件精灵动画，是多媒体显示的核心。"
      },
      "assembly": "motherboard",
      "annotations": [
        "denise_role"
      ]
    },
    {
      "id": "paula",
      "name": "Paula 芯片",
      "type": "chip",
      "role": {
        "zh": "Paula 芯片在整机中负责四声道音频与软驱控制，生成立体声音效，是多媒体声音的核心。"
      },
      "assembly": "motherboard",
      "annotations": [
        "paula_role"
      ]
    },
    {
      "id": "power_switch",
      "name": "电源开关",
      "type": "switch",
      "role": {
