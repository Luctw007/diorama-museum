  "meta": {
    "id": "neo-geo-mvs",
    "name": {
      "zh": "Neo Geo MVS 街机柜",
      "en": "Neo Geo MVS Arcade Cabinet"
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1990,
    "manufacturer": "SNK",
    "category": "game-console",
    "description": "1990 年 SNK 推出的 Neo Geo MVS 街机柜，多视频系统基板配大卡带，孕育了拳皇、侍魂、合金弹头等街机黄金年代名作。",
    "authors": [
      {
        "name": "箱庭电子博物馆项目组",
        "role": "author"
      }
    ],
    "intro": {
      "zh": "Neo Geo MVS（Multi Video System，多视频系统）是 SNK 于 1990 年推出的街机基板，以 68000 主处理器与双卡带槽位设计著称，一台框体可装多张游戏卡、换卡不停机。它孕育了拳皇、侍魂、合金弹头等格斗与射击名作，是街机黄金年代的见证，也是街机厅首台进入博物馆的设备。",
      "en": "The Neo Geo MVS (Multi Video System) is an arcade board released by SNK in 1990, known for its 68000 CPU and dual cartridge slots that allow game swapping without powering down. It birthed The King of Fighters, Samurai Shodown, and Metal Slug, defining the golden age of arcades."
    },
    "sources": [
      {
        "type": "documentation",
        "title": "Wikipedia: Neo Geo (system)",
        "url": "https://en.wikipedia.org/wiki/Neo_Geo_(system)",
        "license": "cc",
        "accessed_at": "2026-11-04"
      },
      {
        "type": "documentation",
        "title": "MAME Driver: Neo Geo",
        "url": "https://wiki.mamedev.org/index.php/Driver:Neo_Geo",
        "license": "licensed",
        "accessed_at": "2026-11-04"
      }
    ]
  },
