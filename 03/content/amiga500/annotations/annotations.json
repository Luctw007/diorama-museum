    {
      "id": "chipset_division",
      "type": "flow",
      "target": "motherboard",
      "text": "三芯片组分工讲解：Agnus 管内存与视频、Denise 管显示、Paula 管声音与软驱，CPU 只做逻辑运算，各司其职。"
    },
    {
      "id": "demo_scene",
      "type": "flow",
      "target": "whole",
      "text": "demo scene 文化讲解：程序员与音乐人用汇编压榨 Amiga 硬件极限，做出同步了音乐与图形的实时演示，是数字时代最早的街头艺术。"
    },
    {
      "id": "ham_mode",
      "type": "flow",
      "target": "denise_chip",
      "text": "HAM 模式讲解：用「保持并修改」的编码技巧，让 1987 年的家用电脑在同一屏显示 4096 种颜色。"
    },
    {
      "id": "multitask_os",
      "type": "flow",
      "target": "whole",
      "text": "多任务系统讲解：AmigaOS 是抢占式多任务操作系统，1987 年就能在 512KB 内存里同时运行多个程序。"
    },
    {
      "id": "stereo_sound",
      "type": "flow",
      "target": "paula_chip",
      "text": "四声道立体声讲解：Paula 芯片输出四声道 PCM 立体声，让 Amiga 成为电子音乐与 MOD 文化的摇篮。"
    },
    {
      "id": "floppy_880k",
      "type": "flow",
      "target": "floppy_drive",
      "text": "880KB 软驱讲解：容量是同期 PC 软驱的两倍多，由 Paula 芯片控制，读盘不占 CPU。"
    },
    {
      "id": "amiga_legacy",
      "type": "flow",
      "target": "whole",
      "text": "Commodore 兴衰讲解：Amiga 是 Commodore 的技术巅峰，却因经营失误在 1994 年破产，留下技术超前、经营落败的教训。"
    },
    {
      "id": "workbench",
      "type": "flow",
      "target": "whole",
      "text": "Workbench 图形界面讲解：Amiga 的桌面环境，让用户以图形化方式管理文件与程序，是早期 GUI 的代表。"
    },
    {
      "id": "amiga_games",
      "type": "flow",
      "target": "whole",
      "text": "游戏生态讲解：Amiga 500 拥有庞大的游戏库，其流畅的卷轴与立体声音乐定义了欧洲游戏的一代记忆。"
    },
    {
      "id": "europe_games",
      "type": "flow",
      "target": "whole",
      "text": "欧洲游戏记忆讲解：Amiga 500 是欧洲家用机的巅峰，其流畅卷轴与立体声音乐定义了欧洲一代人的游戏记忆。"
    }
