{
  "annotations": [
    {
      "id": "whole_role",
      "type": "role",
      "target": "whole",
      "text": "DVD 播放机整机，一台 1990 年代后期取代录像机的家用光盘播放设备，由机箱、光盘托盘、激光头组件、前面板、主板与电源组成，是家电影音厅「画质翻页」叙事线的核心展品。",
      "sources": []
    },
    {
      "id": "disc_tray_role",
      "type": "role",
      "target": "disc_tray",
      "text": "光盘托盘在整机中承载光盘，从前面板入碟口伸出与收回，供用户放碟并送入机内读盘，是可抽拉的进出仓机构。",
      "sources": []
    },
    {
      "id": "tray_mechanism_role",
      "type": "role",
      "target": "disc_tray",
      "text": "托盘进出机构在整机中驱动光盘托盘伸出与收回，把光盘送到主轴上方进入读盘位置。",
      "sources": []
    },
    {
      "id": "disc_role",
      "type": "role",
      "target": "disc_tray",
      "text": "光盘在整机中作为内容的物理载体，表面布满数据凹坑，由激光头读取还原为数字音视频。",
      "sources": []
    },
    {
      "id": "laser_pickup_role",
      "type": "role",
      "target": "laser_pickup",
      "text": "激光头组件在整机中发射红色激光读取光盘上的数据凹坑，沿径向寻道扫描，是整机读取光盘的核心部件。",
      "sources": []
    },
    {
      "id": "front_panel_role",
      "type": "role",
      "target": "front_panel",
      "text": "前面板在整机中承载按键、显示窗与入碟口，是用户操作播放、暂停、出仓等功能的交互面板。",
      "sources": []
    },
    {
      "id": "control_buttons_role",
      "type": "role",
      "target": "front_panel",
      "text": "面板按键组在整机中提供播放、停止、暂停、快进、快退等操作，位于前面板，是播放机的主要操作控件。",
      "sources": []
    },
    {
      "id": "eject_button_role",
      "type": "role",
      "target": "front_panel",
      "text": "出仓键在整机中控制光盘托盘伸出与收回，位于前面板入碟口旁，由用户按压操作。",
      "sources": []
    },
    {
      "id": "display_role",
      "type": "role",
      "target": "front_panel",
      "text": "显示窗在整机中以荧光数码显示播放时间与工作状态，位于前面板，供用户观察播放进度。",
      "sources": []
    },
    {
      "id": "power_supply_role",
      "type": "role",
      "target": "power_supply",
      "text": "电源模块在整机中把市电转换为多路直流电，为主轴电机、激光头与解码电路稳定供电。",
      "sources": []
    },
    {
      "id": "power_switch_role",
      "type": "role",
      "target": "power_supply",
      "text": "电源开关在整机中控制整机的通断电，位于前面板，由用户按压操作。",
      "sources": []
    },
    {
      "id": "mainboard_role",
      "type": "role",
      "target": "mainboard",
      "text": "主板在整机中承载解码、伺服与音频电路，把激光头读出的数据流还原为视频与音频输出。",
      "sources": []
    },
    {
      "id": "decoder_ic_role",
      "type": "role",
      "target": "decoder_ic",
      "text": "解码 IC 在整机中解压 MPEG-2 视频码流与数字音频，还原为可输出的视频与音频信号。",
      "sources": []
    },
    {
      "id": "servo_ic_role",
      "type": "role",
      "target": "servo_ic",
      "text": "伺服控制 IC 在整机中控制主轴转速与激光头寻道，维持读盘的聚焦与循迹稳定。",
      "sources": []
    },
    {
      "id": "audio_ic_role",
      "type": "role",
      "target": "audio_ic",
      "text": "音频解码 IC 在整机中解出数字音频码流，输出多声道或立体声伴音。",
      "sources": []
    },
    {
      "id": "laser_diode_role",
      "type": "role",
      "target": "laser_diode",
      "text": "激光二极管在整机中发射红色激光，经聚焦后照射光盘数据面，是读盘的光源。",
      "sources": []
    },
    {
      "id": "picture_quality_flow",
      "type": "flow",
      "target": "whole",
      "text": "画质翻页：DVD 用高密度光盘与数字压缩取代录像带，画面清晰度与色彩远超 VHS，家庭影音画质跃升一个量级。",
      "sources": []
    },
    {
      "id": "digital_audio_flow",
      "type": "flow",
      "target": "whole",
      "text": "数字音频：DVD 首次把数字多声道音频带进家庭，环绕声让客厅观影体验逼近影院。",
      "sources": []
    },
    {
      "id": "disc_media_flow",
      "type": "flow",
      "target": "whole",
      "text": "光盘介质革命：DVD 光盘以更高的存储密度与随机访问能力取代磁带，内容定位从倒带进化到即点即播。",
      "sources": []
    },
    {
      "id": "av_upgrade_flow",
      "type": "flow",
      "target": "whole",
      "text": "家庭影音升级：DVD 播放机推动家庭从录像带时代升级到光盘时代，带动家庭影院与宽屏电视的普及。",
      "sources": []
    },
    {
      "id": "vhs_succession_flow",
      "type": "flow",
      "target": "whole",
      "text": "与 VHS 的接力：DVD 播放机承接录像机开创的「家庭影像」叙事，以更优画质与交互完成影音时代的换代。",
      "sources": []
    },
    {
      "id": "laser_read_flow",
      "type": "flow",
      "target": "laser_pickup",
      "text": "激光读盘：红色激光聚焦在光盘数据面，识别数据凹坑与平面的反射差异，把数字信号读出送解码。",
      "sources": []
    },
    {
      "id": "tray_flow",
      "type": "flow",
      "target": "disc_tray",
      "text": "托盘进出仓：按出仓键托盘伸出，放碟后再按收回，光盘被主轴夹持旋转进入读盘状态。",
      "sources": []
    },
    {
      "id": "decode_flow",
      "type": "flow",
      "target": "mainboard",
      "text": "解码链路：激光头读出的数据流经主板解复用、解密与解码，还原为视频与音频信号输出。",
      "sources": []
    },
    {
      "id": "mpeg2_flow",
      "type": "flow",
      "target": "mainboard",
      "text": "MPEG-2 压缩：DVD 采用 MPEG-2 视频压缩标准，把海量视频数据压缩到一张光盘可容纳的程度。",
      "sources": []
    },
    {
      "id": "dolby_flow",
      "type": "flow",
      "target": "whole",
      "text": "杜比数字：DVD 支持杜比数字音频，多声道环绕声第一次成为家庭影音的标准配置。",
      "sources": []
    },
    {
      "id": "chapter_nav_flow",
      "type": "flow",
      "target": "front_panel",
      "text": "章节导航：DVD 支持菜单与章节跳转，观众第一次可以在影片中任意跳转，告别倒带的等待。",
      "sources": []
    },
    {
      "id": "home_theater_flow",
      "type": "flow",
      "target": "whole",
      "text": "家庭影院时代：DVD 播放机与宽屏电视、环绕声音响共同构成家庭影院，客厅观影体验全面升级。",
      "sources": []
    },
    {
      "id": "tray_load_anim",
      "type": "anim",
      "target": "disc_tray",
      "text": "托盘进出仓动画：按出仓键托盘伸出、放上光盘、再按收回托盘入机，演示放碟流程；单次全程约 2 秒。",
      "sources": []
    },
    {
      "id": "disc_read_anim",
      "type": "anim",
      "target": "laser_pickup",
      "text": "读盘动画：光盘旋转、激光头沿径向寻道扫描，演示激光读取数据的过程；全程约 2 秒。",
      "sources": []
    }
  ]
}
