{
  "annotations": [
    {
      "id": "whole_role",
      "type": "role",
      "target": "whole",
      "text": "Apple iPhone 初代整机，2007 年发布的智能手机，以多点触控与无物理键盘重新定义了手机。"
    },
    {
      "id": "case_role",
      "type": "role",
      "target": "case",
      "text": "机身外壳在整机中作为铝制后壳与前玻璃面板构成的一体机身，承载 Home 键、电源键与摄像头。"
    },
    {
      "id": "display_role",
      "type": "role",
      "target": "display",
      "text": "显示屏在整机中由玻璃盖板、触控层与 LCD 面板叠合而成，是 3.5 英寸多点触控的显示界面。"
    },
    {
      "id": "pcb_role",
      "type": "role",
      "target": "pcb",
      "text": "主板在整机中承载 ARM11 处理器、内存、闪存与基带、WiFi 芯片，是整机的运算与通信核心。"
    },
    {
      "id": "battery_role",
      "type": "role",
      "target": "battery",
      "text": "电池在整机中作为内置不可拆卸锂离子电池，为整机供电，是机身一体设计的一部分。"
    },
    {
      "id": "dock_connector_role",
      "type": "role",
      "target": "dock_connector",
      "text": "Dock 接口在整机中位于机身底部，是 30 针充电与数据同步接口，也是整机唯一的外部有线接口。"
    },
    {
      "id": "home_button_role",
      "type": "role",
      "target": "home_button",
      "text": "Home 键在整机中位于屏幕下方，是唯一的正面实体按键，用于返回主屏幕。"
    },
    {
      "id": "sleep_wake_button_role",
      "type": "role",
      "target": "sleep_wake_button",
      "text": "电源键在整机中位于机身顶部，用于锁屏、唤醒与开关机。"
    },
    {
      "id": "camera_role",
      "type": "role",
      "target": "camera",
      "text": "后置摄像头在整机中位于机身背部上方，为 200 万像素定焦摄像头。"
    },
    {
      "id": "sim_tray_role",
      "type": "role",
      "target": "sim_tray",
      "text": "SIM 卡槽在整机中位于机身顶部，容纳 SIM 卡以接入蜂窝网络。"
    },
    {
      "id": "speaker_grill_role",
      "type": "role",
      "target": "speaker_grill",
      "text": "扬声器孔在整机中位于机身底部，外放通话、铃声与媒体声音。"
    },
    {
      "id": "mic_hole_role",
      "type": "role",
      "target": "mic_hole",
      "text": "麦克风孔在整机中位于机身底部，采集用户语音用于通话与录音。"
    },
    {
      "id": "lcd_panel_role",
      "type": "role",
      "target": "lcd_panel",
      "text": "LCD 面板在整机中显示画面，为 3.5 英寸、320×480 分辨率的彩色液晶屏。"
    },
    {
      "id": "touch_digitizer_role",
      "type": "role",
      "target": "touch_digitizer",
      "text": "触控层在整机中感知多点电容触控，是 iPhone 多点触控交互的核心传感器。"
    },
    {
      "id": "glass_cover_role",
      "type": "role",
      "target": "glass_cover",
      "text": "玻璃盖板在整机中覆盖显示屏表面，保护内层并为手指滑动提供顺滑表面。"
    },
    {
      "id": "cpu_arm11_role",
      "type": "role",
      "target": "cpu_arm11",
      "text": "ARM11 处理器在整机中作为计算核心，是苹果向 ARM 架构转型后的早期移动处理器。"
    },
    {
      "id": "ram_role",
      "type": "role",
      "target": "ram",
      "text": "内存在整机中存放运行中的程序与数据，容量 128MB。"
    },
    {
      "id": "flash_storage_role",
      "type": "role",
      "target": "flash_storage",
      "text": "闪存在整机中存储操作系统、应用与用户数据，初代提供 4GB 或 8GB 容量。"
    },
    {
      "id": "gsm_chip_role",
      "type": "role",
      "target": "gsm_chip",
      "text": "基带芯片在整机中处理蜂窝通信，初代支持 GSM/EDGE（2.5G）网络，不支持 3G。"
    },
    {
      "id": "wifi_chip_role",
      "type": "role",
      "target": "wifi_chip",
      "text": "WiFi 芯片在整机中提供 802.11b/g 无线网络连接，用于上网与数据同步。"
    },
    {
      "id": "accelerometer_role",
      "type": "role",
      "target": "accelerometer",
      "text": "加速度计在整机中感知机身姿态，使屏幕画面随横竖旋转自动切换。"
    },
    {
      "id": "battery_cell_role",
      "type": "role",
      "target": "battery_cell",
      "text": "锂离子电池在整机中储存电能，为整机供电，且为不可拆卸的内置设计。"
    },
    {
      "id": "dock_port_role",
      "type": "role",
      "target": "dock_port",
      "text": "30 针 Dock 接口在整机中用于充电与连接电脑同步数据，是初代 iPhone 的唯一有线接口。"
    },
    {
      "id": "macworld_2007",
      "type": "flow",
      "target": "whole",
      "text": "2007 发布会讲解：2007 年 1 月 9 日，乔布斯在 Macworld 上宣称苹果「重新发明了手机」，用一台无键盘的大屏设备震撼全场。"
    },
    {
      "id": "multi_touch",
      "type": "flow",
      "target": "touch_digitizer",
      "text": "多点触控讲解：iPhone 用多点电容触控替代了触控笔与按键，手指的捏合、滑动、点按成为新的交互语言。"
    },
    {
      "id": "no_keyboard",
      "type": "flow",
      "target": "whole",
      "text": "无物理键盘讲解：iPhone 大胆取消了实体键盘，用虚拟键盘取而代之，换来更大的屏幕，也引发「没有键盘怎么打字」的争议。"
    },
    {
      "id": "touch_revolution",
      "type": "flow",
      "target": "whole",
      "text": "触屏革命讲解：iPhone 之后，触屏手机迅速成为主流，它重新定义了人与手机交互的方式，是智能手机革命的分水岭。"
    },
    {
      "id": "edge_network",
      "type": "flow",
      "target": "gsm_chip",
      "text": "EDGE 网络讲解：初代 iPhone 仅支持 2.5G EDGE，不支持 3G，上网速度慢是它最常被诟病的短板之一。"
    },
    {
      "id": "no_app_store",
      "type": "flow",
      "target": "whole",
      "text": "无 App Store 讲解：初代 iPhone 并未预装应用商店，第三方应用直到 2008 年 App Store 随 iPhone 3G 上线才成为可能。"
    },
    {
      "id": "builtin_battery",
      "type": "flow",
      "target": "battery_cell",
      "text": "内置电池讲解：初代 iPhone 采用不可拆卸的内置电池，这一设计当时引发争议，后来却成为行业主流。"
    },
    {
      "id": "iphone_os",
      "type": "flow",
      "target": "flash_storage",
      "text": "iPhone OS 讲解：初代运行 iPhone OS（后更名 iOS），一个为触屏从头设计的移动操作系统，奠定了苹果移动生态的根基。"
    },
    {
      "id": "arm_shift",
      "type": "flow",
      "target": "cpu_arm11",
      "text": "ARM 转型讲解：初代 iPhone 采用 ARM11 处理器，是苹果转向 ARM 架构的重要一步，也为后来自研芯片埋下伏笔。"
    },
    {
      "id": "accelerometer",
      "type": "flow",
      "target": "accelerometer",
      "text": "横竖屏讲解：内置加速度计让屏幕随机身旋转自动切换横竖，是最早让用户直观感受到「手机懂姿态」的功能之一。"
    }
  ]
}