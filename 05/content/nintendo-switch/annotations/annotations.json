{
  "annotations": [
    {"id": "tablet_role", "type": "role", "target": "tablet", "text": "Nintendo Switch 平板主体，一台 2017 年任天堂发布的融合型游戏机核心，由屏幕、主板、电池与卡带槽组成，是主机掌机二合一的整机核心。", "sources": []},
    {"id": "dock_role", "type": "role", "target": "dock", "text": "底座 Dock 在整机中用于承载平板主体，入坞后切换到电视模式，是主机掌机切换的关键部件。", "sources": []},
    {"id": "joycon_left_role", "type": "role", "target": "joycon_left", "text": "左 Joy-Con 在整机中作为左侧可拆手柄，通过滑轨卡合到平板两侧，是可拆识别件。", "sources": []},
    {"id": "joycon_right_role", "type": "role", "target": "joycon_right", "text": "右 Joy-Con 在整机中作为右侧可拆手柄，通过滑轨卡合到平板两侧，是可拆识别件。", "sources": []},
    {"id": "mainboard_role", "type": "role", "target": "mainboard", "text": "主板在整机中承载 Tegra X1 处理器与主内存，是整机运行游戏的计算核心。", "sources": []},
    {"id": "battery_role", "type": "role", "target": "battery", "text": "电池在整机中为平板主体供电，支撑掌机模式的续航。", "sources": []},
    {"id": "cartridge_slot_role", "type": "role", "target": "cartridge_slot", "text": "卡带槽在整机中位于平板顶部，插入游戏卡带，是游戏介质入口。", "sources": []},
    {"id": "screen_role", "type": "role", "target": "screen", "text": "屏幕在整机中位于平板正面，显示游戏画面，是掌机模式的显示核心。", "sources": []},
    {"id": "tegra_x1_role", "type": "role", "target": "tegra_x1", "text": "Tegra X1 处理器在整机中执行游戏逻辑与运算，是整机的运算核心。", "sources": []},
    {"id": "ram_role", "type": "role", "target": "ram", "text": "主内存芯片在整机中提供工作内存，暂存运行时的程序与图形数据。", "sources": []},
    {"id": "gpu_role", "type": "role", "target": "gpu", "text": "图形核心在整机中绘制画面，是 Tegra X1 集成的图形处理核心。", "sources": []},
    {"id": "battery_ic_role", "type": "role", "target": "battery_ic", "text": "电池管理芯片在整机中管理电池充放电，保障续航与安全。", "sources": []},
    {"id": "slide_rail_role", "type": "role", "target": "tablet", "text": "滑轨在整机中位于平板两侧，供 Joy-Con 卡合与拆卸，是形态切换的机械接口。", "sources": []},
    {"id": "ir_camera_role", "type": "role", "target": "joycon_right", "text": "红外摄像头在整机中位于右 Joy-Con 底部，用于感知距离与识别手势。", "sources": []},
    {"id": "usb_c_role", "type": "role", "target": "dock", "text": "USB-C 接口在整机中位于平板底部与 Dock，用于充电与电视模式视频输出。", "sources": []},
    {"id": "kickstand_role", "type": "role", "target": "tablet", "text": "支架在整机中位于平板背部，展开后可支撑桌面模式。", "sources": []},
    {"id": "hybrid_flow", "type": "flow", "target": "tablet", "text": "二合一融合：Switch 把主机与掌机融为一体，玩家可在电视、桌面、掌机三种模式间自由切换。", "sources": []},
    {"id": "fusion_flow", "type": "flow", "target": "tablet", "text": "融合路线破亿：Switch 的融合路线大获成功，成为任天堂史上最畅销的主机之一。", "sources": []},
    {"id": "dock_flow", "type": "flow", "target": "dock", "text": "入坞切换：把平板滑入 Dock，画面即刻切换到电视，实现从掌机到主机的无缝切换。", "sources": []},
    {"id": "joycon_flow", "type": "flow", "target": "joycon_left", "text": "Joy-Con 卡合：左右 Joy-Con 通过滑轨卡合到平板，拆下后可单人或双人使用。", "sources": []},
    {"id": "cpu_gpu_flow", "type": "flow", "target": "mainboard", "text": "SoC 一体化：Tegra X1 集成 CPU 与图形核心，让掌机形态也能运行主机级游戏。", "sources": []},
    {"id": "handheld_flow", "type": "flow", "target": "battery", "text": "掌机续航：电池为掌机模式供电，让玩家可以随时随地游玩。", "sources": []},
    {"id": "cartridge_flow", "type": "flow", "target": "cartridge_slot", "text": "卡带介质：Switch 使用卡带作为游戏介质，读取快速、便于携带。", "sources": []},
    {"id": "screen_flow", "type": "flow", "target": "screen", "text": "屏幕显示：掌机模式下游戏画面由平板屏幕呈现，触控操作随点随玩。", "sources": []},
    {"id": "tabletop_flow", "type": "flow", "target": "tablet", "text": "桌面模式：展开支架，平板可立在桌面上，配合拆下的 Joy-Con 双人游玩。", "sources": []},
    {"id": "local_multiplayer_flow", "type": "flow", "target": "joycon_left", "text": "本地联机：拆下一对 Joy-Con 即可双人同乐，本地多人成为 Switch 的社交亮点。", "sources": []},
    {"id": "online_flow", "type": "flow", "target": "tablet", "text": "在线服务：Switch 提供在线对战与数字商店，让玩家随时联网游戏。", "sources": []},
    {"id": "lab_flow", "type": "flow", "target": "joycon_right", "text": "创意外设：Joy-Con 的多功能让纸板 DIY 等创意玩法成为可能。", "sources": []},
    {"id": "dock_anim", "type": "anim", "target": "dock", "text": "入坞动画：把平板滑入 Dock、画面切换到电视、主机模式启动；单次全程约 2 秒。", "sources": []},
    {"id": "boot_anim", "type": "anim", "target": "tablet", "text": "开机动画：按下电源键，屏幕点亮并进入主界面；全程约 2 秒。", "sources": []}
  ]
}
