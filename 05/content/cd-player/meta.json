{
  "$schema": "../schema/device_spec.schema.json",
  "meta": {
    "id": "cd-player",
    "name": {
      "zh": "CD 播放机",
      "en": "CD Player"
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "authors": [
      {
        "name": "箱庭电子博物馆项目组",
        "role": "author"
      }
    ],
    "description": "1982 年诞生的数字光盘播放设备，用激光读取 CD 光盘、还原数字音频，让家庭音响第一次进入高保真数字时代，是家电影音厅站 6「数字音频」的代表展品。",
    "category": "appliance",
    "sources": [
      {
        "type": "documentation",
        "title": "Wikipedia: CD player",
        "url": "https://en.wikipedia.org/wiki/CD_player",
        "license": "cc",
        "accessed_at": "2026-11-20"
      },
      {
        "type": "documentation",
        "title": "Wikipedia: Compact disc",
        "url": "https://en.wikipedia.org/wiki/Compact_disc",
        "license": "cc",
        "accessed_at": "2026-11-20"
      },
      {
        "type": "documentation",
        "title": "Computer History Museum",
        "url": "https://www.computerhistory.org/",
        "license": "visual_reference_only",
        "accessed_at": "2026-11-20"
      }
    ],
    "intro": {
      "zh": "CD 播放机是 1982 年诞生的数字光盘播放设备，用激光读取 CD 光盘上的数字音频，把音乐第一次以高保真数字形式送进家庭。它开启了数字音频时代，是家电影音厅「数字音频」叙事的主角，也是后来 DVD 与数字影音的先声。",
      "en": "The CD player, born in 1982, uses a laser to read digital audio from compact discs, bringing high-fidelity digital music into the home for the first time. It opened the digital audio era and is the protagonist of the digital-audio narrative, as well as the forerunner of the DVD and digital video."
    },
    "era": 1982,
    "manufacturer": "通用（品类代表）"
  },
  "assemblies": [
    {
      "id": "whole",
      "name": "整机",
      "role": {
        "zh": "CD 播放机整机，由机箱、光盘托盘、激光头组件、前面板、主板与电源组成，是家电影音厅站 6「数字音频」的核心展品。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": null,
      "children": ["disc_tray", "laser_pickup", "front_panel", "power_supply", "mainboard"],
      "components": [],
      "annotations": ["whole_role", "digital_audio_revolution_flow", "cd_first_flow"],
      "mesh_ref": "assemblies/whole.gltf"
    },
    {
      "id": "disc_tray",
      "name": "光盘托盘",
      "role": {
        "zh": "光盘托盘在整机中承载 CD 光盘，从前面板入碟口伸出与收回，供用户放碟并送入机内读盘，是可抽拉的进出仓机构。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["disc_tray_role", "tray_mechanism_role", "disc_role", "tray_flow"],
      "mesh_ref": "assemblies/disc_tray.gltf"
    },
    {
      "id": "laser_pickup",
      "name": "激光头组件",
      "role": {
        "zh": "激光头组件在整机中发射激光读取光盘上的数字音频数据，沿径向寻道扫描，是整机读取光盘的核心部件。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["laser_diode"],
      "annotations": ["laser_pickup_role", "laser_read_flow"],
      "mesh_ref": "assemblies/laser_pickup.gltf"
    },
    {
      "id": "front_panel",
      "name": "前面板",
      "role": {
        "zh": "前面板在整机中承载按键、显示窗与入碟口，是用户操作播放、暂停、跳轨等功能的交互面板。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["front_panel_role", "control_buttons_role", "eject_button_role", "display_role", "chapter_flow"],
      "mesh_ref": "assemblies/front_panel.gltf"
    },
    {
      "id": "power_supply",
      "name": "电源模块",
      "role": {
        "zh": "电源模块在整机中把市电转换为多路直流电，为主轴电机、激光头与解码电路稳定供电。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["power_supply_role", "power_switch_role"],
      "mesh_ref": "assemblies/power_supply.gltf"
    },
    {
      "id": "mainboard",
      "name": "主板（机芯板）",
      "role": {
        "zh": "主板在整机中承载解码、伺服与音频电路，把激光头读出的数字音频还原为可输出的模拟音频。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["decoder_ic", "servo_ic", "audio_ic"],
      "annotations": ["mainboard_role", "decode_flow", "pcm_flow"],
      "mesh_ref": "assemblies/mainboard.gltf"
    }
  ],
  "components": [
    {
      "id": "decoder_ic",
      "name": "解码 IC",
      "type": "ic",
      "role": {
        "zh": "解码 IC 在整机中处理 CD 的数字音频码流，完成纠错与数模转换。"
      },
      "assembly": "mainboard",
      "annotations": ["decoder_ic_role"]
    },
    {
      "id": "servo_ic",
      "name": "伺服控制 IC",
      "type": "ic",
      "role": {
        "zh": "伺服控制 IC 在整机中控制主轴转速与激光头寻道，维持读盘的聚焦与循迹稳定。"
      },
      "assembly": "mainboard",
      "annotations": ["servo_ic_role"]
    },
    {
      "id": "audio_ic",
      "name": "音频数模转换 IC",
      "type": "ic",
      "role": {
        "zh": "音频数模转换 IC 在整机中把数字音频码流转换为模拟音频，输出到放大器。"
      },
      "assembly": "mainboard",
      "annotations": ["audio_ic_role"]
    },
    {
      "id": "laser_diode",
      "name": "激光二极管",
      "type": "diode",
      "role": {
        "zh": "激光二极管在整机中发射激光，经聚焦后照射光盘数据面，是读盘的光源。"
      },
      "assembly": "laser_pickup",
      "annotations": ["laser_diode_role"]
    }
  ],
  "runtime": {
    "emulator": "none",
    "version": "1.0.0",
    "system": "CD 播放机（静态展示）",
    "media_hint": "none",
    "bios_required": false,
    "bios_guide_url": null,
    "output_sinks": [
      {
        "id": "crt_display_0",
        "surface": "crt_display",
        "type": "video",
        "format": "rgba8"
      },
      {
        "id": "speaker_0",
        "surface": "speaker",
        "type": "audio",
        "format": "pcm16"
      }
    ],
    "input_map": {
      "power": {
        "map": "keyboard",
        "key": "KEY_P"
      },
      "play": {
        "map": "keyboard",
        "key": "KEY_ENTER"
      },
      "stop": {
        "map": "keyboard",
        "key": "KEY_S"
      },
      "pause": {
        "map": "keyboard",
        "key": "KEY_SPACE"
      },
      "fast_forward": {
        "map": "keyboard",
        "key": "KEY_F"
      },
      "rewind": {
        "map": "keyboard",
        "key": "KEY_B"
      },
      "eject": {
        "map": "keyboard",
        "key": "KEY_E"
      },
      "demo_next": {
        "map": "keyboard",
        "key": "KEY_DOWN"
      }
    }
  }
}
