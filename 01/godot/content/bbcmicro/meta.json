  "components": [
    {
      "id": "cpu_6502",
      "name": "6502 处理器",
      "type": "cpu",
      "role": {
        "zh": "6502 处理器在整机中作为主控芯片，以 2 MHz 执行 BBC BASIC 程序与系统逻辑。"
      },
      "assembly": "motherboard",
      "annotations": [
        "cpu_6502_role"
      ]
    },
    {
      "id": "video_ula",
      "name": "Video ULA 图形芯片",
      "type": "gpu",
      "role": {
        "zh": "Video ULA 图形芯片在整机中支持 MODE 0–7 多种显示模式，从高分辨率单色到 Teletext 彩色文本。"
      },
      "assembly": "motherboard",
      "annotations": [
        "video_ula_role"
      ]
    },
    {
      "id": "rom",
      "name": "BBC BASIC + MOS ROM",
      "type": "rom",
      "role": {
        "zh": "BBC BASIC + MOS ROM 在整机中固化先进的结构化 BASIC 解释器与操作系统，实现开机即编程。"
      },
      "assembly": "motherboard",
      "annotations": [
        "rom_role"
      ]
    },
    {
      "id": "ram",
      "name": "内存（16/32KB）",
      "type": "ram",
      "role": {
