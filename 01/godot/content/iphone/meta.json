      "role": {
        "zh": "SIM 卡槽在整机中位于机身顶部，容纳 SIM 卡以接入蜂窝网络。"
      },
      "assembly": "case",
      "annotations": [
        "sim_tray_role"
      ]
    },
    {
      "id": "speaker_grill",
      "name": "扬声器孔",
      "type": "port",
      "role": {
        "zh": "扬声器孔在整机中位于机身底部，外放通话、铃声与媒体声音。"
      },
      "assembly": "case",
      "annotations": [
        "speaker_grill_role"
      ]
    },
    {
      "id": "mic_hole",
      "name": "麦克风孔",
      "type": "port",
      "role": {
        "zh": "麦克风孔在整机中位于机身底部，采集用户语音用于通话与录音。"
      },
      "assembly": "case",
      "annotations": [
        "mic_hole_role"
      ]
    },
