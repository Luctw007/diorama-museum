{
  "annotations": [
    {"id": "chassis_role", "type": "role", "target": "chassis", "text": "Game Boy Advance 横置机身，一台 2001 年任天堂发布的 32 位掌机主体，含十字键区与 AB 键，是横置双手握持的识别件。", "sources": []},
    {"id": "dpad_role", "type": "role", "target": "chassis", "text": "十字键区在整机中位于屏幕左侧，提供八方向输入，是掌机的主要方向控制。", "sources": []},
    {"id": "screen_role", "type": "role", "target": "screen", "text": "屏幕在整机中位于正面中央，显示游戏画面，是掌机的显示核心。", "sources": []},
    {"id": "cartridge_slot_role", "type": "role", "target": "cartridge_slot", "text": "卡带槽在整机中位于顶部，插入游戏卡带，是可插拔的识别件。", "sources": []},
    {"id": "shoulder_buttons_role", "type": "role", "target": "shoulder_buttons", "text": "肩键区在整机中位于顶部两侧，L/R 肩键为掌机操作提供额外输入。", "sources": []},
    {"id": "battery_compartment_role", "type": "role", "target": "battery_compartment", "text": "电池仓在整机中位于背部，装载电池为掌机供电。", "sources": []},
    {"id": "arm7_role", "type": "role", "target": "arm7", "text": "ARM7TDMI CPU 在整机中执行游戏逻辑与运算，是整机的运算核心。", "sources": []},
    {"id": "ppu_role", "type": "role", "target": "ppu", "text": "图形芯片在整机中绘制画面，是整机的图形处理核心。", "sources": []},
    {"id": "ram_role", "type": "role", "target": "ram", "text": "主内存芯片在整机中提供工作内存，暂存运行时的程序与图形数据。", "sources": []},
    {"id": "sound_ic_role", "type": "role", "target": "sound_ic", "text": "音源芯片在整机中生成游戏音效，是整机的音频核心。", "sources": []},
    {"id": "ab_button_role", "type": "role", "target": "chassis", "text": "AB 键在整机中位于屏幕右侧，是掌机的主要动作按键。", "sources": []},
    {"id": "start_select_role", "type": "role", "target": "chassis", "text": "开始/选择键在整机中位于屏幕下方，用于游戏菜单与暂停。", "sources": []},
    {"id": "cartridge_role", "type": "role", "target": "cartridge_slot", "text": "游戏卡带在整机中作为游戏介质，插入顶部卡带槽后由主机读取运行。", "sources": []},
    {"id": "speaker_role", "type": "role", "target": "chassis", "text": "扬声器在整机中位于机身下方，播放游戏音效。", "sources": []},
    {"id": "link_port_role", "type": "role", "target": "chassis", "text": "联机口在整机中位于顶部，用于连接两台掌机联机对战。", "sources": []},
    {"id": "lcd_role", "type": "role", "target": "screen", "text": "液晶屏在整机中呈现彩色游戏画面，是 GBA 相较前代 Game Boy 的显示升级。", "sources": []},
    {"id": "landscape_flow", "type": "flow", "target": "chassis", "text": "横置造型：GBA 采用横版机身，十字键左、AB 键右，是掌机横置握持的代表形态。", "sources": []},
    {"id": "screen_flow", "type": "flow", "target": "screen", "text": "屏幕显示：彩色液晶屏让 GBA 的画面表现相较前代大幅提升。", "sources": []},
    {"id": "cartridge_flow", "type": "flow", "target": "cartridge_slot", "text": "卡带插拔：把游戏卡带插入顶部卡带槽，主机读取卡带后启动游戏。", "sources": []},
    {"id": "shoulder_flow", "type": "flow", "target": "shoulder_buttons", "text": "肩键操作：L/R 肩键为横置握持下的食指提供额外输入。", "sources": []},
    {"id": "battery_flow", "type": "flow", "target": "battery_compartment", "text": "电池供电：电池仓装载电池，为掌机提供便携续航。", "sources": []},
    {"id": "bit32_flow", "type": "flow", "target": "chassis", "text": "32 位升级：GBA 是 Game Boy 系向 32 位过渡的关键一代，性能大幅跃升。", "sources": []},
    {"id": "backward_compat_flow", "type": "flow", "target": "cartridge_slot", "text": "向下兼容：GBA 兼容前代 Game Boy 与 Game Boy Color 的卡带，保护老玩家收藏。", "sources": []},
    {"id": "gb_legacy_flow", "type": "flow", "target": "chassis", "text": "Game Boy 系传承：GBA 延续 Game Boy 系的掌机血统，是任天堂掌机线的中坚。", "sources": []},
    {"id": "portable_flow", "type": "flow", "target": "chassis", "text": "便携性：GBA 小巧轻便，让玩家可以随时随地畅玩 32 位游戏。", "sources": []},
    {"id": "link_cable_flow", "type": "flow", "target": "chassis", "text": "联机对战：联机口让两台 GBA 可以联机，多人同乐成为掌机的社交亮点。", "sources": []},
    {"id": "game_library_flow", "type": "flow", "target": "chassis", "text": "庞大游戏库：GBA 拥有庞大的游戏库，覆盖角色扮演、动作、益智等全类型。", "sources": []},
    {"id": "color_flow", "type": "flow", "target": "screen", "text": "彩色画面：彩色液晶屏让 GBA 得以呈现丰富多彩的游戏世界。", "sources": []},
    {"id": "cartridge_insert_anim", "type": "anim", "target": "cartridge_slot", "text": "卡带插拔动画：把游戏卡带插入顶部卡带槽、主机读取卡带后开机；单次全程约 2 秒。", "sources": []},
    {"id": "boot_anim", "type": "anim", "target": "chassis", "text": "开机动画：拨动电源开关，屏幕点亮并进入游戏启动画面；全程约 2 秒。", "sources": []}
  ]
}
