    "id": "macintosh128k",
    "name": {
      "zh": "Macintosh 128K",
      "en": "Macintosh 128K"
    },
    "intro": {
      "zh": "Macintosh 128K 是 1984 年苹果推出的首台面向大众的图形界面个人计算机，以 68000 处理器、9 英寸黑白屏、鼠标与位图 GUI 把图形界面带进千家万户。",
      "en": "The Macintosh 128K, introduced by Apple in 1984, brought the graphical user interface and mouse to the mass market."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1984,
    "manufacturer": "Apple",
    "category": "personal-computer",
    "description": "Macintosh 128K（1984），苹果首台大众图形界面个人计算机：68000 CPU、128KB 内存、9 英寸单显（512×342）、3.5 英寸 400KB 软驱、单键鼠标。",
    "authors": [
