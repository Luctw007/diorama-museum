    "name": {
      "zh": "Commodore 64",
      "en": "Commodore 64"
    },
    "intro": {
      "zh": "Commodore 64 是 1982 年推出的史上最畅销单一计算机型号，以 6510 处理器、VIC-II 图形与 SID 声音三芯片架构，把个人计算机带进千家万户。",
      "en": "The Commodore 64, released in 1982, is the best-selling single computer model of all time."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1982,
    "manufacturer": "Commodore International",
    "category": "personal-computer",
    "description": "Commodore 64（1982），史上最畅销单机型：6510 CPU、64KB 内存、VIC-II 图形、SID 声音，约 595 美元。",
    "authors": [
      {
        "name": "TASK-38A 生产",
        "role": "author"
      }
    ],
