      "name": "ARM11 处理器",
      "type": "cpu",
      "role": {
        "zh": "ARM11 处理器在整机中作为计算核心，是苹果向 ARM 架构转型后的早期移动处理器。"
      },
      "assembly": "pcb",
      "annotations": [
        "cpu_arm11_role"
      ]
    },
    {
      "id": "ram",
      "name": "内存",
      "type": "ram",
      "role": {
        "zh": "内存在整机中存放运行中的程序与数据，容量 128MB。"
      },
      "assembly": "pcb",
      "annotations": [
        "ram_role"
      ]
    },
    {
      "id": "flash_storage",
      "name": "闪存",
      "type": "storage",
      "role": {
        "zh": "闪存在整机中存储操作系统、应用与用户数据，初代提供 4GB 或 8GB 容量。"
      },
      "assembly": "pcb",
      "annotations": [
        "flash_storage_role"
      ]
    },
    {
      "id": "gsm_chip",
      "name": "基带芯片",
      "type": "ic",
      "role": {
        "zh": "基带芯片在整机中处理蜂窝通信，初代支持 GSM/EDGE（2.5G）网络，不支持 3G。"
      },
      "assembly": "pcb",
      "annotations": [
        "gsm_chip_role"
      ]
    },
    {
      "id": "wifi_chip",
      "name": "WiFi 芯片",
      "type": "ic",
      "role": {
        "zh": "WiFi 芯片在整机中提供 802.11b/g 无线网络连接，用于上网与数据同步。"
      },
      "assembly": "pcb",
      "annotations": [
        "wifi_chip_role"
      ]
    },
    {
      "id": "accelerometer",
      "name": "加速度计",
      "type": "sensor",
      "role": {
        "zh": "加速度计在整机中感知机身姿态，使屏幕画面随横竖旋转自动切换。"
      },
      "assembly": "pcb",
      "annotations": [
        "accelerometer_role"
      ]
    },
    {
