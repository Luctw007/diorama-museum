    {"id": "gpu", "name": "GPU", "type": "ic", "role": {"zh": "GPU 在整机中负责图形处理与裸眼 3D 渲染，将游戏画面输出到上屏，是图形与立体显示的核心。"}, "assembly": "chassis", "annotations": ["gpu_role"]},
    {"id": "ram", "name": "主内存芯片", "type": "ic", "role": {"zh": "主内存芯片在整机中提供工作内存，暂存运行时的程序、画面与声音数据，支撑系统与游戏流畅运行。"}, "assembly": "chassis", "annotations": ["ram_role"]},
    {"id": "sound_ic", "name": "音源芯片", "type": "ic", "role": {"zh": "音源芯片在整机中生成游戏音效与音乐，驱动扬声器发声，是音频核心。"}, "assembly": "chassis", "annotations": ["sound_ic_role"]}
