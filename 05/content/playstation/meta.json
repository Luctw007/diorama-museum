      "name": "手柄接口",
      "role": {
        "zh": "手柄接口在整机中连接游戏手柄，把玩家的按键操作送入主机，是整机的主要输入接口。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
