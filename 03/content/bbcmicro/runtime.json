{
  "emulator": "beebem",
  "version": "4.19.0",
  "system": "BBC Micro",
  "media_hint": "tape",
  "bios_required": false,
  "bios_guide_url": null,
  "output_sinks": [
    {
      "id": "external_crt_0",
      "surface": "external_crt",
      "type": "video",
      "format": "rgba8"
    },
    {
      "id": "speaker_0",
      "surface": "speaker",
      "type": "audio",
      "format": "pcm16"
    },
    {
      "id": "led_0",
      "surface": "led",
      "type": "video",
      "format": "mono1"
    }
  ],
  "input_map": {
    "power": {
      "map": "keyboard",
      "key": "KEY_POWER"
    },
    "reset": {
      "map": "keyboard",
      "key": "KEY_RESET"
    },
    "break": {
      "map": "keyboard",
      "key": "KEY_ESCAPE"
    },
    "return": {
      "map": "keyboard",
      "key": "KEY_ENTER"
    },
    "space": {
      "map": "keyboard",
      "key": "KEY_SPACE"
    },
    "joystick_up": {
      "map": "joystick",
      "key": "axis_y"
    },
    "joystick_fire": {
      "map": "joystick",
      "key": "btn0"
    }
  }
}
