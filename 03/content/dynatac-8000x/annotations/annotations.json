{
  "annotations": [
    {
      "id": "whole_role",
      "type": "role",
      "target": "whole",
      "text": "Motorola DynaTAC 8000X 整机，1983 年获 FCC 批准的首台商用便携式蜂窝移动电话。"
    },
    {
      "id": "body_role",
      "type": "role",
      "target": "body",
      "text": "机身外壳在整机中作为黑色塑料上下两半结构，承载显示屏、麦克风与全部内部组件。"
