      "name": "LCD 面板",
      "type": "lcd",
      "role": {
        "zh": "LCD 面板在整机中显示画面，为 3.5 英寸、320×480 分辨率的彩色液晶屏。"
      },
      "assembly": "display",
      "annotations": [
        "lcd_panel_role"
      ]
    },
    {
      "id": "touch_digitizer",
      "name": "触控层",
      "type": "sensor",
      "role": {
        "zh": "触控层在整机中感知多点电容触控，是 iPhone 多点触控交互的核心传感器。"
      },
      "assembly": "display",
      "annotations": [
        "touch_digitizer_role"
      ]
    },
    {
      "id": "glass_cover",
      "name": "玻璃盖板",
      "type": "cover",
      "role": {
        "zh": "玻璃盖板在整机中覆盖显示屏表面，保护内层并为手指滑动提供顺滑表面。"
      },
      "assembly": "display",
      "annotations": [
        "glass_cover_role"
      ]
    },
    {
