    {"id": "control_buttons", "name": "按键区", "role": {"zh": "按键区在整机中位于正面，含十字键、△○×□ 键与左右双摇杆，是掌机的主要操作输入。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["control_buttons_role","dual_analog_role","face_buttons_role","dpad_role","dual_analog_flow"], "mesh_ref": "assemblies/control_buttons.gltf"},
