  "meta": {
    "id": "pdp11",
    "name": {
      "zh": "DEC PDP-11/70",
      "en": "DEC PDP-11/70"
    },
    "intro": {
      "zh": "DEC PDP-11/70 是 1975 年推出的 PDP-11 家族高端机型，以 Unibus 统一总线与内存管理单元成为 16 位小型机的性能标杆，也是 UNIX 与 C 语言的重要孵化平台。",
      "en": "The DEC PDP-11/70, introduced in 1975, is the high-end model of the PDP-11 family, a 16-bit minicomputer landmark and an incubator for UNIX and C."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1975,
    "manufacturer": "Digital Equipment Corporation (DEC)",
    "category": "minicomputer",
    "description": "DEC PDP-11/70（1975），PDP-11 家族高端机型：16 位字、Unibus 统一总线、内存管理单元、UNIX/C 的孵化平台。",
