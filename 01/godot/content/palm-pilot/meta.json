  "meta": {
    "id": "palm-pilot",
    "name": {
      "zh": "Palm Pilot 1000",
      "en": "Palm Pilot 1000"
    },
    "intro": {
      "zh": "Palm Pilot 1000 是 Palm 1996 年推出的掌上电脑，以触控笔、Graffiti 手写与 HotSync 同步定义 PDA 品类，是智能手机前夜的关键一站。",
      "en": "The Palm Pilot 1000, launched in 1996, defined the PDA category with its stylus, Graffiti handwriting and HotSync cradle, a key step on the eve of the smartphone."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1996,
    "manufacturer": "Palm",
    "category": "pda",
    "description": "Palm Pilot 1000（1996），PDA 标杆：DragonBall MC68328、128KB 内存、单色触控屏 160×160、Graffiti 手写、HotSync 底座。演示向（Mu/PHEM/CloudpilotEmu 预留）。",
    "authors": [
