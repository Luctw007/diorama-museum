{
  "meta": {
    "id": "amiga500",
    "name": {
      "zh": "Amiga 500",
      "en": "Commodore Amiga 500"
    },
    "intro": {
      "zh": "Amiga 500 是 1987 年 Commodore 推出的 16 位家用电脑，以 68000 处理器与三芯片组（Agnus/Denise/Paula）实现了超前的多媒体能力，是欧洲家用电脑的巅峰。",
      "en": "The Amiga 500, launched by Commodore in 1987, delivered ahead-of-its-time multimedia with its 68000 CPU and the Agnus/Denise/Paula chipset."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1987,
    "manufacturer": "Commodore",
    "category": "personal-computer",
    "description": "Amiga 500（1987），欧洲家用电脑巅峰：68000 CPU 7.14MHz、512KB Chip RAM、三芯片组（Agnus/Denise/Paula）、4096 色 HAM、四声道立体声、880KB 软驱、AmigaOS 多任务。",
    "authors": [
      {
        "name": "TASK-68B 生产",
        "role": "author"
      }
    ],
