  "meta": {
    "id": "x68000",
    "name": {
      "zh": "Sharp X68000",
      "en": "Sharp X68000"
    },
    "intro": {
      "zh": "Sharp X68000 是夏普 1987 年推出的 16 位个人电脑，仅面向日本市场，以街机级 16 位色彩图形与内置 FM+PCM 音频被誉为「日本街机移植之王」。",
      "en": "The Sharp X68000, launched in 1987 for the Japanese market, was a 16-bit personal computer famed as the king of arcade ports thanks to its arcade-grade colour graphics and built-in FM+PCM audio."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1987,
    "manufacturer": "Sharp",
    "category": "personal-computer",
    "description": "Sharp X68000（1987），日本街机移植之王：68000 10MHz、16 位色彩（65536 色）、内置 FM（YM2151）+PCM 音频、塔式双立式机箱。demo_mode，XM6 槽位 dedicated 预留。",
    "authors": [
      {
        "name": "TASK-103A 生产",
        "role": "author"
      }
    ],
