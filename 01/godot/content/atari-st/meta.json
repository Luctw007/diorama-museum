    "id": "atari-st",
    "name": {
      "zh": "Atari ST",
      "en": "Atari ST"
    },
    "intro": {
      "zh": "Atari ST 是 1985 年雅达利推出的 16 位个人电脑，以 68000 处理器、内置 MIDI 接口与单色高分辨率显示，成为音乐制作与桌面出版的性价比之选。",
      "en": "The Atari ST, launched by Atari in 1985, was a 16-bit computer that became the go-to machine for music production and desktop publishing thanks to built-in MIDI and high-res monochrome display."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1985,
    "manufacturer": "Atari",
    "category": "personal-computer",
    "description": "Atari ST（1985），16 位个人电脑：68000 CPU 8MHz、512KB 内存、内置 MIDI、640×400 单色高分辨率、GEM 图形界面、3.5 英寸软驱。",
