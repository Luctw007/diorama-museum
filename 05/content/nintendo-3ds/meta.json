    "intro": {
      "zh": "Nintendo 3DS 是任天堂 2011 年发布的裸眼 3D 双屏掌机，上屏支持无需眼镜的裸眼 3D 显示、下屏触控，向下兼容 DS，销量超 7500 万台，延续并拓展了双屏触控掌机的成功。",
      "en": "The Nintendo 3DS, released by Nintendo in 2011, is an autostereoscopic dual-screen handheld whose upper display shows glasses-free 3D and lower screen is a touch screen; backward compatible with the DS, it sold over 75 million units and extended the success of the dual-screen touch handheld."
    },
    "era": 2011, "manufacturer": "Nintendo"
  },
  "assemblies": [
    {"id": "chassis", "name": "翻盖机身", "role": {"zh": "翻盖式机身，在整机中作为主体结构，经铰链将裸眼 3D 上屏与下触屏连为一体，内含按键区、圆盘摇杆、卡带槽与电池仓，是裸眼 3D 双屏掌机的识别件。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": null, "children": ["top_screen","touch_screen","cartridge_slot","shoulder_buttons","battery_compartment"], "components": ["arm11_cpu","gpu","ram","sound_ic"], "annotations": ["chassis_role","dpad_role","abxy_role","circle_pad_role","hinge_role","dual_screen_flow","clamshell_flow","best_seller_flow","clamshell_anim"], "mesh_ref": "assemblies/chassis.gltf"},
    {"id": "top_screen", "name": "裸眼 3D 上屏", "role": {"zh": "裸眼 3D 上屏在整机中位于翻盖上盖内侧，作为主显示屏幕，通过视差屏障呈现无需眼镜的裸眼 3D 画面，与下触屏共同构成双屏布局。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["top_screen_role","stereoscopic_role","stereoscopic_flow","handheld_lcd_flow"], "mesh_ref": "assemblies/top_screen.gltf"},
    {"id": "touch_screen", "name": "下触屏", "role": {"zh": "下触屏在整机中位于机身下半部，既是显示屏幕又是触控输入面，配合触控笔实现点击、书写与滑动操作，是标志性识别件。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["touch_screen_role","stylus_role","touch_flow","touch_game_flow"], "mesh_ref": "assemblies/touch_screen.gltf"},
    {"id": "cartridge_slot", "name": "卡带槽", "role": {"zh": "卡带槽在整机中位于机身背部，用于插入 3DS 游戏卡带，主机读取卡带后启动游戏，是可插拔的识别件。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["cartridge_slot_role","cartridge_flow","ds_compat_flow","cartridge_insert_anim"], "mesh_ref": "assemblies/cartridge_slot.gltf"},
    {"id": "shoulder_buttons", "name": "肩键区", "role": {"zh": "肩键区在整机中位于机身两侧顶部，L/R 肩键为食指提供额外输入，是掌机握持操作的重要组成。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["shoulder_buttons_role","shoulder_flow"], "mesh_ref": "assemblies/shoulder_buttons.gltf"},
    {"id": "battery_compartment", "name": "电池仓", "role": {"zh": "电池仓在整机中位于机身底部，装载电池为掌机供电，是便携续航的保障。"}, "transform": {"translation": [0.0,0.0,0.0], "rotation": [0.0,0.0,0.0,1.0], "scale": [1.0,1.0,1.0]}, "parent": "chassis", "children": [], "components": [], "annotations": ["battery_compartment_role","battery_flow"], "mesh_ref": "assemblies/battery_compartment.gltf"}
  ],
