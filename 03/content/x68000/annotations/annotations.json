{
  "annotations": [
    {
      "id": "whole_role",
      "type": "role",
      "target": "whole",
      "text": "Sharp X68000 整机，1987 年推出的 16 位个人电脑，以街机级图形与音频被誉为「日本街机移植之王」。"
    },
    {
      "id": "main_tower_role",
      "type": "role",
      "target": "main_tower",
      "text": "主机塔在整机中作为塔式立式机箱，与显示器塔分立，承载主板、软驱位与电源，是系统的结构骨架。"
    },
    {
      "id": "keyboard_role",
      "type": "role",
      "target": "keyboard",
      "text": "键盘在整机中作为独立 101 键输入设备，是 X68000 的文字与命令输入界面。"
    },
    {
      "id": "mouse_role",
      "type": "role",
      "target": "mouse",
      "text": "鼠标在整机中作为专用滚球指针设备，配合图形界面进行点选操作。"
    },
    {
      "id": "motherboard_role",
      "type": "role",
      "target": "motherboard",
      "text": "主板在整机中承载 68000 处理器、图形芯片、FM 与 PCM 音频芯片、内存与 IPL ROM，是系统运算核心。"
    },
    {
      "id": "floppy_bay_role",
      "type": "role",
      "target": "floppy_bay",
      "text": "5.25 英寸软驱位在整机中位于主机塔前部，安装双软驱，是程序与数据的可移动存储入口。"
    },
    {
      "id": "power_role",
      "type": "role",
      "target": "power",
      "text": "电源在整机中为各部件供电，是塔式机箱内的供电单元。"
    },
    {
      "id": "brand_badge_role",
      "type": "role",
      "target": "brand_badge",
      "text": "品牌徽标在整机中标明 SHARP 品牌与 X68000 型号。"
    },
    {
      "id": "power_switch_role",
      "type": "role",
      "target": "power_switch",
      "text": "电源开关在整机中控制主机塔的供电通断，是系统的上电入口。"
    },
    {
      "id": "reset_button_role",
      "type": "role",
      "target": "reset_button",
      "text": "复位按钮在整机中用于软复位系统，回到开机状态而不切断电源。"
    },
    {
      "id": "scsi_port_role",
      "type": "role",
      "target": "scsi_port",
      "text": "SCSI 接口在整机中连接外置硬盘等 SCSI 设备，是高速存储扩展的物理通道。"
    },
    {
      "id": "expansion_slots_role",
      "type": "role",
      "target": "expansion_slots",
      "text": "扩展槽在整机中安装显卡、内存等扩展卡，为系统升级提供插接位。"
    },
    {
      "id": "key_matrix_role",
      "type": "role",
      "target": "key_matrix",
      "text": "键盘矩阵在整机中承载 101 键按键，是 X68000 的主要文字输入部件。"
    },
    {
      "id": "trackball_role",
      "type": "role",
      "target": "trackball",
      "text": "滚球在整机中位于鼠标底部，通过滚动检测位移，是鼠标指针定位的核心部件。"
    },
    {
      "id": "cpu_68000_role",
      "type": "role",
      "target": "cpu_68000",
      "text": "68000 处理器在整机中作为计算核心，主频 10 MHz，是 16 位时代的经典 CPU。"
    },
    {
      "id": "gpu_chip_role",
      "type": "role",
      "target": "gpu_chip",
      "text": "图形芯片在整机中生成 16 位色彩（65536 色）画面，最高 512×512 分辨率，是街机级图形的来源。"
    },
    {
      "id": "ym2151_fm_role",
      "type": "role",
      "target": "ym2151_fm",
      "text": "YM2151 FM 合成芯片在整机中生成 FM 合成音色，是内置高品质音乐的核心音频单元。"
    },
    {
      "id": "pcm_chip_role",
      "type": "role",
      "target": "pcm_chip",
      "text": "PCM 采样芯片在整机中播放 8 声道数字采样音频，与 FM 合成共同构成完整声音系统。"
    },
    {
      "id": "ram_role",
      "type": "role",
      "target": "ram",
      "text": "内存在整机中存放运行中的程序与数据，起始容量 1MB，可扩展。"
    },
    {
      "id": "ipl_rom_role",
      "type": "role",
      "target": "ipl_rom",
      "text": "IPL ROM 在整机中固化系统引导固件，是 X68000 开机自举的只读存储器。"
    },
    {
      "id": "floppy_drive_a_role",
      "type": "role",
      "target": "floppy_drive_a",
      "text": "软驱 A 在整机中读写 5.25 英寸软盘，是主软盘驱动器。"
    },
    {
      "id": "floppy_drive_b_role",
      "type": "role",
      "target": "floppy_drive_b",
      "text": "软驱 B 在整机中读写第二张 5.25 英寸软盘，用于数据交换与软件安装。"
    },
    {
      "id": "power_supply_role",
      "type": "role",
      "target": "power_supply",
      "text": "电源单元在整机中把市电转换为各部件所需直流电，是塔式机箱的供电核心。"
    },
    {
      "id": "power_jack_role",
      "type": "role",
      "target": "power_jack",
      "text": "电源接口在整机中接纳电源线，为整机供电的入口。"
    },
    {
      "id": "arcade_port_king",
      "type": "flow",
      "target": "whole",
      "text": "街机移植之王讲解：X68000 的图形与音频能力逼近街机基板，大量 CAPCOM、Konami 街机游戏被高保真移植，是「在家玩街机」的典范。"
    },
    {
      "id": "sixteen_bit_trinity",
      "type": "flow",
      "target": "whole",
      "text": "16 位三强讲解：X68000 与 Amiga、Atari ST 同用 68000，却各有性格——Amiga 表演家、Atari ST 实干家、X68000 街机玩家。"
    },
    {
      "id": "twin_tower",
      "type": "flow",
      "target": "main_tower",
      "text": "塔式双立式机箱讲解：主机塔与显示器塔分立成两座细塔，是个人电脑史上极具辨识度的工业设计，一眼难忘。"
    },
    {
      "id": "fm_pcm_audio",
      "type": "flow",
      "target": "ym2151_fm",
      "text": "内置 FM+PCM 音频讲解：X68000 无需外接声卡即可获得高品质合成音乐，是电子音乐与游戏音乐爱好者的心头好。"
    },
    {
      "id": "sixteen_bit_color",
      "type": "flow",
      "target": "gpu_chip",
      "text": "16 位色彩讲解：图形芯片提供 65536 色与最高 512×512 分辨率，是当时家用电脑中罕有的街机级显示能力。"
    },
    {
      "id": "japan_only",
      "type": "flow",
      "target": "whole",
      "text": "日本市场独有讲解：X68000 仅在日本发售，未走欧美路线，是日本家用电脑独立于欧美生态的鲜明样本。"
    },
    {
      "id": "motorola_68000",
      "type": "flow",
      "target": "cpu_68000",
      "text": "68000 血脉讲解：继 Macintosh、Amiga、Atari ST 之后，X68000 是 68000 在 1980 年代末的又一支强劲血脉。"
    },
    {
      "id": "capcom_ports",
      "type": "flow",
      "target": "whole",
      "text": "CAPCOM 移植讲解：X68000 上大量 CAPCOM 街机游戏获得接近原机的移植，成为街机游戏收藏者的珍藏平台。"
    },
    {
      "id": "scsi_storage",
      "type": "flow",
      "target": "scsi_port",
      "text": "SCSI 存储讲解：通过 SCSI 接口可外接硬盘，弥补软盘容量不足，是 X68000 迈向实用工作站的关键扩展。"
    },
    {
      "id": "dual_floppy",
      "type": "flow",
      "target": "floppy_bay",
      "text": "双软驱讲解：主机塔内置双 5.25 英寸软驱，早期软件与游戏多以多张软盘发行，双软驱免去频繁换盘之苦。"
    }
  ]
}