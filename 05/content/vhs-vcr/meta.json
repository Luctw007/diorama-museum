{
  "$schema": "../schema/device_spec.schema.json",
  "meta": {
    "id": "vhs-vcr",
    "name": {
      "zh": "VHS 录像机",
      "en": "VHS Video Cassette Recorder"
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "authors": [
      {
        "name": "箱庭电子博物馆项目组",
        "role": "author"
      }
    ],
    "description": "1976 年诞生的 VHS 标准家用录像机，把电视节目录到磁带上，让节目第一次可以被录下回看，是家电影音厅站 3「录下回看」的代表展品。",
    "category": "appliance",
    "sources": [
      {
        "type": "documentation",
        "title": "Wikipedia: VHS",
        "url": "https://en.wikipedia.org/wiki/VHS",
        "license": "cc",
        "accessed_at": "2026-11-19"
      },
      {
        "type": "documentation",
        "title": "Wikipedia: Videocassette recorder",
        "url": "https://en.wikipedia.org/wiki/Videocassette_recorder",
        "license": "cc",
        "accessed_at": "2026-11-19"
      },
      {
        "type": "documentation",
        "title": "Computer History Museum",
        "url": "https://www.computerhistory.org/",
        "license": "visual_reference_only",
        "accessed_at": "2026-11-19"
      }
    ],
    "intro": {
      "zh": "VHS 录像机是 1976 年由 JVC 推出的家用录像标准，用一盒磁带把电视节目录下来、随时回看，第一次打破了「错过即错过」的线性播出。它赢得了与 Betamax 的格式大战，成为 1980 年代到 1990 年代全球最普及的家用录像设备，是家电影音厅「录下回看」叙事的主角。",
      "en": "The VHS video cassette recorder, introduced by JVC in 1976, recorded television programs onto magnetic tape for later playback, breaking the linear broadcast model for the first time. It won the format war against Betamax and became the most widespread home video device of the 1980s and 1990s."
    },
    "era": 1976,
    "manufacturer": "通用（品类代表）"
  },
  "assemblies": [
    {
      "id": "whole",
      "name": "整机",
      "role": {
        "zh": "VHS 录像机整机，由机箱、磁带加载机构、磁头鼓、前面板、主板与电源组成，是家电影音厅站 3「录下回看」的核心展品。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": null,
      "children": ["cassette_mechanism", "head_drum", "front_panel", "power_supply", "mainboard"],
      "components": [],
      "annotations": ["whole_role", "vhs_birth_flow", "record_playback_flow"],
      "mesh_ref": "assemblies/whole.gltf"
    },
    {
      "id": "cassette_mechanism",
      "name": "磁带加载机构（带仓）",
      "role": {
        "zh": "磁带加载机构在整机中承接入带口的磁带，把磁带从带盒中拉出并绕到磁头鼓上，是整机加载磁带的核心机构。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["cassette_mechanism_role", "cassette_role", "cassette_loading_flow"],
      "mesh_ref": "assemblies/cassette_mechanism.gltf"
    },
    {
      "id": "head_drum",
      "name": "磁头鼓（视频磁鼓）",
      "role": {
        "zh": "磁头鼓在整机中以斜装方式高速旋转，用旋转磁头在磁带上螺旋扫描读写视频信号，是录像机最核心的识别部件。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["drum_motor"],
      "annotations": ["head_drum_role", "drum_rotation_role", "drum_rotation_flow", "helical_scan_flow"],
      "mesh_ref": "assemblies/head_drum.gltf"
    },
    {
      "id": "front_panel",
      "name": "前面板",
      "role": {
        "zh": "前面板在整机中承载按键、显示窗与入带口，是用户操作录像机录制、播放与回看的交互面板。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["front_panel_role", "control_buttons_role", "record_button_role", "display_role", "record_flow"],
      "mesh_ref": "assemblies/front_panel.gltf"
    },
    {
      "id": "power_supply",
      "name": "电源模块",
      "role": {
        "zh": "电源模块在整机中把市电转换为多路直流电，为磁鼓电机、伺服与信号电路稳定供电。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["power_supply_role", "power_switch_role"],
      "mesh_ref": "assemblies/power_supply.gltf"
    },
    {
      "id": "mainboard",
      "name": "主板（机芯板）",
      "role": {
        "zh": "主板在整机中承载伺服、视频信号处理与伴音电路，把磁头鼓读出的信号还原为可输出的视频与伴音。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["servo_ic", "video_signal_ic", "audio_ic"],
      "annotations": ["mainboard_role", "signal_path_flow"],
      "mesh_ref": "assemblies/mainboard.gltf"
    }
  ],
  "components": [
    {
      "id": "servo_ic",
      "name": "伺服控制 IC",
      "type": "ic",
      "role": {
        "zh": "伺服控制 IC 在整机中控制磁头鼓转速与磁带走带速度，维持螺旋扫描的相位稳定。"
      },
      "assembly": "mainboard",
      "annotations": ["servo_ic_role"]
    },
    {
      "id": "video_signal_ic",
      "name": "视频信号处理 IC",
      "type": "ic",
      "role": {
        "zh": "视频信号处理 IC 在整机中处理磁头鼓读出的亮度与色度信号，还原为复合视频输出。"
      },
      "assembly": "mainboard",
      "annotations": ["video_signal_ic_role"]
    },
    {
      "id": "audio_ic",
      "name": "音频信号 IC",
      "type": "ic",
      "role": {
        "zh": "音频信号 IC 在整机中处理磁带上的音频磁迹信号，还原为伴音输出。"
      },
      "assembly": "mainboard",
      "annotations": ["audio_ic_role"]
    },
    {
      "id": "drum_motor",
      "name": "磁鼓电机",
      "type": "motor",
      "role": {
        "zh": "磁鼓电机在整机中驱动磁头鼓高速旋转，使旋转磁头以斜向螺旋方式扫描磁带。"
      },
      "assembly": "head_drum",
      "annotations": ["drum_motor_role"]
    }
  ],
  "runtime": {
