    {
      "id": "charge_contact_role",
      "type": "role",
      "target": "charge_contact",
      "text": "充电触点在整机中与充电座对接，为电池组补充电能，充满约需 10 小时。"
    },
    {
      "id": "first_commercial_phone",
      "type": "flow",
      "target": "whole",
      "text": "第一台商用手机讲解：DynaTAC 8000X 是 1983 年获 FCC 批准、1984 年上市的首台商用便携式蜂窝移动电话，开启个人无线通讯时代。"
    },
    {
      "id": "martin_cooper_1973",
      "type": "flow",
      "target": "whole",
      "text": "1973 首通电话讲解：1973 年 4 月 3 日，摩托罗拉工程师马丁·库珀用 DynaTAC 原型机拨出第一通手持电话，打给了竞争对手贝尔实验室，是手机史的起点。"
    },
    {
      "id": "big_brother_culture",
      "type": "flow",
      "target": "whole",
      "text": "大哥大文化讲解：DynaTAC 进入中国后被俗称为「大哥大」，是 1990 年代初财富与身份的象征。"
    },
    {
      "id": "thirty_min_talk",
      "type": "flow",
      "target": "battery",
      "text": "通话与充电讲解：DynaTAC 通话约 30 分钟、充电却要约 10 小时，这一悬殊比例道尽早期手机性能与便利的极限拉扯。"
    },
    {
      "id": "amps_1g",
      "type": "flow",
      "target": "antenna",
      "text": "1G 模拟网络讲解：DynaTAC 运行于第一代模拟蜂窝网络 AMPS，通话以模拟信号承载，是数字手机出现前的移动通信形态。"
    },
    {
      "id": "brick_phone",
      "type": "flow",
      "target": "body",
      "text": "砖头机形态讲解：DynaTAC 重近 1 公斤、售价 3995 美元，被戏称为「砖头机」，是移动通信奢侈年代最直观的物证。"
    },
    {
      "id": "rf_principle",
      "type": "flow",
      "target": "rf_frontend",
      "text": "射频原理讲解：射频前端负责把语音调制到高频载波上发射，并从空中接收基站信号解调还原，是无线通话的物理基础。"
    },
    {
      "id": "cellular_principle",
      "type": "flow",
      "target": "freq_synth",
      "text": "蜂窝原理讲解：频率合成器让手机在不同蜂窝小区间切换信道，实现移动中的连续通话，是蜂窝网络得名的由来。"
    },
    {
      "id": "demo_oriented",
      "type": "flow",
      "target": "whole",
      "text": "演示向讲解：本机无成熟模拟器，展厅以静态展陈、射频原理动画与按键铃声合成交互呈现，属演示向展项。"
    },
    {
      "id": "nicd_battery",
      "type": "flow",
      "target": "battery_cell",
      "text": "镍镉电池讲解：早期手机普遍使用镍镉电池，能量密度低、充电慢，是整机又大又重的重要原因。"
    },
    {
      "id": "price_3995",
      "type": "flow",
      "target": "body",
      "text": "奢侈定价讲解：3995 美元的售价让 DynaTAC 在 1980 年代成为少数人的专属，移动通信最初是昂贵的稀缺资源。"
    }
