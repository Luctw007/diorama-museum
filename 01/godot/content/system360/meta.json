    "name": {
      "zh": "IBM System/360 Model 30",
      "en": "IBM System/360 Model 30"
    },
    "intro": {
      "zh": "IBM System/360 是 1964 年发布的兼容计算机家族，Model 30 是其入门商用机型，以微程序控制与通道式 I/O 实现一套指令集覆盖商用与科学应用。",
      "en": "IBM System/360, announced in 1964, is the compatible mainframe family; the Model 30 is its entry business model."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
