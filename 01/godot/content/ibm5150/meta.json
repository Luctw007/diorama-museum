    "id": "ibm5150",
    "name": {
      "zh": "IBM PC 5150",
      "en": "IBM Personal Computer 5150"
    },
    "intro": {
      "zh": "IBM PC 5150 是 1981 年推出的开放架构个人计算机，以 x86 架构、MS-DOS 与开放总线奠定 IBM 兼容机标准，催生整个 PC 产业。",
      "en": "The IBM PC 5150, introduced in 1981, established the open IBM PC standard and spawned the entire PC industry."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1981,
    "manufacturer": "IBM",
    "category": "personal-computer",
    "description": "IBM PC 5150（1981），开放架构个人计算机：8088 CPU、16–64KB 内存、MDA/CGA 显示、ISA 开放总线。",
