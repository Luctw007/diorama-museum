      "id": "whole",
      "name": "整机",
      "role": {
        "zh": "PlayStation 整机，由机箱、光驱、主板、电源、手柄接口与记忆卡槽组成，是游戏机厅第五代主机与光盘叙事线的核心展品。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
