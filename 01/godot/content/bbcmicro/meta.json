{
  "meta": {
    "id": "bbcmicro",
    "name": {
      "zh": "BBC Micro",
      "en": "BBC Micro"
    },
    "intro": {
      "zh": "BBC Micro 是 1981 年推出的英国国民教育电脑，以先进的 BBC BASIC 与 Tube 接口成为英国计算机扫盲计划的载体，并孕育出 ARM 架构。",
      "en": "The BBC Micro, released in 1981, is the UK's national educational computer and the cradle of the ARM architecture."
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "era": 1981,
    "manufacturer": "Acorn Computers",
    "category": "personal-computer",
    "description": "BBC Micro（1981），英国国民教育电脑：6502 CPU、16/32KB 内存、Video ULA 多模式显示、Tube 接口，ARM 架构的摇篮。",
    "authors": [
      {
        "name": "TASK-43A 生产",
        "role": "author"
      }
    ],
    "sources": [
