      },
      "assembly": "case",
      "annotations": [
        "power_switch_role"
      ]
    },
    {
      "id": "power_led",
      "name": "电源指示灯",
      "type": "lamp",
      "role": {
        "zh": "电源指示灯在整机中点亮表示系统已上电，是判断机器是否开启的状态指示。"
      },
      "assembly": "case",
      "annotations": [
        "power_led_role"
      ]
