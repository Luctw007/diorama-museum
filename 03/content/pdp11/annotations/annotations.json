{
  "annotations": [
    {
      "id": "terminal_role",
      "type": "role",
      "target": "terminal",
      "text": "操作终端在整机中作为操作员与系统交互的输入输出界面，用于键入命令与查看输出。"
    },
    {
      "id": "lamp_run_role",
      "type": "role",
      "target": "lamp_run",
      "text": "运行指示灯在整机中点亮表示处理器正在执行程序，是判断系统是否运行的状态指示。"
    },
    {
      "id": "lamp_power_role",
      "type": "role",
      "target": "lamp_power",
      "text": "电源指示灯在整机中点亮表示系统已上电，是判断机器是否开启的首要状态指示。"
    },
    {
      "id": "lamp_halt_role",
      "type": "role",
      "target": "lamp_halt",
      "text": "停机指示灯在整机中点亮表示处理器已停机，等待操作员干预。"
    },
    {
      "id": "lamp_battery_role",
      "type": "role",
      "target": "lamp_battery",
      "text": "电池指示灯在整机中点亮表示系统由后备电池供电，提示检查交流电源。"
    },
    {
      "id": "lamp_io_activity_role",
      "type": "role",
      "target": "lamp_io_activity",
      "text": "I/O 活动指示灯在整机中闪烁表示 Unibus 上有设备正在进行输入输出操作。"
    },
    {
      "id": "lamp_cache_role",
      "type": "role",
      "target": "lamp_cache",
      "text": "缓存指示灯在整机中点亮表示处理器缓存处于活动状态，加速内存访问。"
    },
    {
      "id": "sw_boot_role",
      "type": "role",
      "target": "sw_boot",
      "text": "引导开关在整机中触发引导程序，从指定设备读入并启动操作系统。"
    },
    {
      "id": "sw_halt_role",
      "type": "role",
      "target": "sw_halt",
      "text": "停机开关在整机中使处理器停机，机器进入等待操作员干预的状态。"
    },
    {
      "id": "sw_start_role",
      "type": "role",
      "target": "sw_start",
      "text": "启动开关在整机中使处理器从当前地址开始或恢复执行程序。"
    },
    {
      "id": "sw_cont_role",
      "type": "role",
      "target": "sw_cont",
      "text": "继续开关在整机中使处理器从暂停处继续执行程序，用于调试后的恢复运行。"
    },
    {
      "id": "sw_load_addr_role",
      "type": "role",
      "target": "sw_load_addr",
      "text": "装载地址开关在整机中把操作员设定的地址送入程序计数器，定位要检视或写入的存储单元。"
    },
    {
      "id": "sw_exam_role",
