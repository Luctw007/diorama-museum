      "name": "30 针 Dock 接口",
      "type": "connector",
      "role": {
        "zh": "30 针 Dock 接口在整机中用于充电与连接电脑同步数据，是初代 iPhone 的唯一有线接口。"
      },
      "assembly": "dock_connector",
      "annotations": [
