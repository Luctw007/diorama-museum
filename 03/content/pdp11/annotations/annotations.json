      "type": "role",
      "target": "tape_reel",
      "text": "磁带卷轴在整机中承载一盘磁带，供读写头沿磁带表面顺序读写数据。"
    },
    {
      "id": "tape_head_role",
      "type": "role",
      "target": "tape_head",
      "text": "磁带读写头在整机中贴着磁带表面读写磁记录，是磁带机与数据交互的核心部件。"
    },
    {
      "id": "tape_controller_role",
      "type": "role",
      "target": "tape_controller",
      "text": "磁带控制器在整机中管理 TU10/TS11 磁带机的走带与读写操作。"
    },
    {
      "id": "unibus_backplane_role",
      "type": "role",
      "target": "unibus_backplane",
      "text": "Unibus 背板在整机中提供统一总线，把 CPU、内存与各设备控制器互联，是 PDP-11 架构的灵魂。"
    },
    {
      "id": "device_controller_role",
      "type": "role",
      "target": "device_controller",
      "text": "设备控制器插卡在整机中挂载于 Unibus 背板，把外设寄存器和内存统一编址，供 CPU 直接读写。"
    },
    {
      "id": "whole_role",
      "type": "role",
      "target": "whole",
      "text": "DEC PDP-11/70 整机，1975 年推出的 PDP-11 家族高端机型，以 Unibus 统一总线与内存管理单元定义 16 位小型机的性能标杆。"
    },
    {
      "id": "unibus_flow",
      "type": "flow",
      "target": "whole",
      "text": "Unibus 数据流：CPU 或外设经 Unibus 访问内存或设备寄存器，内存与设备统一编址，支持 DMA 直接内存访问。"
    },
    {
      "id": "boot_flow",
      "type": "flow",
      "target": "whole",
      "text": "引导流程：操作员按引导开关 → 系统从指定设备（RK05 磁盘或磁带）读入引导程序 → 引导程序装入内存并启动操作系统。"
    },
    {
      "id": "console_role",
      "type": "role",
      "target": "console",
      "text": "操作台在整机中作为操作员与系统交互的界面，集成终端、状态灯组与控制开关。"
    },
    {
      "id": "cpu_cabinet_role",
      "type": "role",
      "target": "cpu_cabinet",
      "text": "CPU 柜在整机中承载处理器、高速缓存与内存管理单元，是执行指令与地址映射的核心单元。"
    },
    {
      "id": "disk_rk05_role",
      "type": "role",
      "target": "disk_rk05",
      "text": "RK05 磁盘组在整机中提供可换盘式磁盘存储，是程序与数据的主要随机存取介质。"
    },
    {
      "id": "tape_tu10_role",
      "type": "role",
      "target": "tape_tu10",
      "text": "TU10/TS11 磁带机在整机中提供磁带的顺序存取，用于数据备份与批量加载。"
    },
    {
      "id": "unibus_rack_role",
      "type": "role",
      "target": "unibus_rack",
      "text": "Unibus 扩展架在整机中提供统一总线背板与设备控制器插槽，是内存与设备统一编址的物理载体。"
    },
    {
      "id": "unix_birthplace",
      "type": "flow",
      "target": "whole",
      "text": "Unix 与 C 孵化讲解：贝尔实验室的 Ken Thompson 与 Dennis Ritchie 正是在 PDP-11 上把 Unix 移植成形，并为重写它发明了 C 语言。"
    },
    {
      "id": "unibus_philosophy",
      "type": "flow",
      "target": "unibus_backplane",
      "text": "Unibus 统一总线讲解：PDP-11 用一条 Unibus 把 CPU、内存、外设全部接在一起，外设寄存器像内存地址一样可读写，I/O 编程由此变得简洁。"
    },
    {
      "id": "orthogonal_isa",
      "type": "flow",
      "target": "processor",
      "text": "正交指令集讲解：PDP-11 的 8 个通用寄存器与 8 种寻址方式可自由组合，这种「正交性」成了处理器设计的黄金标准。"
    },
    {
      "id": "pc_as_register",
      "type": "flow",
      "target": "processor",
      "text": "PC 当寄存器讲解：PDP-11 把程序计数器也当成普通寄存器，于是「取指后 PC 自动加一」从硬件设计里免费涌现，优雅至极。"
    },
    {
      "id": "sixteen_bit_era",
      "type": "flow",
      "target": "whole",
      "text": "16 位时代讲解：PDP-11 是 16 位小型机的代表，以其优雅设计卖出了数十万台，成为 DEC 最畅销的机器。"
    },
    {
      "id": "dec_minicomputer",
      "type": "flow",
      "target": "whole",
      "text": "DEC 小型机讲解：PDP-11 是 DEC 小型机帝国的中坚，把「小型机」从工具推向了范式，定义了整整一代计算机的设计。"
    },
    {
      "id": "terminal_era",
      "type": "flow",
      "target": "terminal",
      "text": "终端时代讲解：PDP-11 通过终端让多用户分时共用一台主机，是「服务器 + 终端」计算模式的早期形态。"
    },
    {
      "id": "rk05_disk",
      "type": "flow",
      "target": "disk_rk05",
      "text": "RK05 磁盘讲解：RK05 可换盘式磁盘是 PDP-11 的主力存储，让程序与数据首次有了随机访问的大容量载体。"
    }
  ]
}