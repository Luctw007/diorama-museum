{
  "$schema": "../schema/device_spec.schema.json",
  "meta": {
    "id": "dvd-player",
    "name": {
      "zh": "DVD 播放机",
      "en": "DVD Player"
    },
    "spec_version": "0.2",
    "version": "1.0.0",
    "engine_min_version": "0.1.0",
    "precision_level": "L2",
    "authors": [
      {
        "name": "箱庭电子博物馆项目组",
        "role": "author"
      }
    ],
    "description": "1997 后家庭影音画质翻页的光盘播放设备，用激光读取 DVD 光盘、输出数字画质与数字音频，是家电影音厅站 4「画质翻页」的代表展品。",
    "category": "appliance",
    "sources": [
      {
        "type": "documentation",
        "title": "Wikipedia: DVD player",
        "url": "https://en.wikipedia.org/wiki/DVD_player",
        "license": "cc",
        "accessed_at": "2026-11-20"
      },
      {
        "type": "documentation",
        "title": "Wikipedia: DVD",
        "url": "https://en.wikipedia.org/wiki/DVD",
        "license": "cc",
        "accessed_at": "2026-11-20"
      },
      {
        "type": "documentation",
        "title": "Computer History Museum",
        "url": "https://www.computerhistory.org/",
        "license": "visual_reference_only",
        "accessed_at": "2026-11-20"
      }
    ],
    "intro": {
      "zh": "DVD 播放机是 1990 年代后期取代 VHS 录像机的家用光盘播放设备，用红色激光读取高密度 DVD 光盘，带来远超录像带的画质与数字音频，让家庭影音第一次「画质翻页」。它是家电影音厅「画质翻页」叙事的主角，也是家庭影院时代到来的标志。",
      "en": "The DVD player was the home optical disc device that replaced the VHS VCR in the late 1990s, using a red laser to read high-density DVDs and delivering picture quality and digital audio far beyond videotape, marking a leap forward for home video."
    },
    "era": 1997,
    "manufacturer": "通用（品类代表）"
  },
  "assemblies": [
    {
      "id": "whole",
      "name": "整机",
      "role": {
        "zh": "DVD 播放机整机，由机箱、光盘托盘、激光头组件、前面板、主板与电源组成，是家电影音厅站 4「画质翻页」的核心展品。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": null,
      "children": ["disc_tray", "laser_pickup", "front_panel", "power_supply", "mainboard"],
      "components": [],
      "annotations": ["whole_role", "picture_quality_flow", "digital_audio_flow"],
      "mesh_ref": "assemblies/whole.gltf"
    },
    {
      "id": "disc_tray",
      "name": "光盘托盘",
      "role": {
        "zh": "光盘托盘在整机中承载光盘，从前面板入碟口伸出与收回，供用户放碟并送入机内读盘，是可抽拉的进出仓机构。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["disc_tray_role", "tray_mechanism_role", "disc_role", "tray_flow"],
      "mesh_ref": "assemblies/disc_tray.gltf"
    },
    {
      "id": "laser_pickup",
      "name": "激光头组件",
      "role": {
        "zh": "激光头组件在整机中发射红色激光读取光盘上的数据凹坑，沿径向寻道扫描，是整机读取光盘的核心部件。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["laser_diode"],
      "annotations": ["laser_pickup_role", "laser_read_flow"],
      "mesh_ref": "assemblies/laser_pickup.gltf"
    },
    {
      "id": "front_panel",
      "name": "前面板",
      "role": {
        "zh": "前面板在整机中承载按键、显示窗与入碟口，是用户操作播放、暂停、出仓等功能的交互面板。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["front_panel_role", "control_buttons_role", "eject_button_role", "display_role", "chapter_nav_flow"],
      "mesh_ref": "assemblies/front_panel.gltf"
    },
    {
      "id": "power_supply",
      "name": "电源模块",
      "role": {
        "zh": "电源模块在整机中把市电转换为多路直流电，为主轴电机、激光头与解码电路稳定供电。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": [],
      "annotations": ["power_supply_role", "power_switch_role"],
      "mesh_ref": "assemblies/power_supply.gltf"
    },
    {
      "id": "mainboard",
      "name": "主板（机芯板）",
      "role": {
        "zh": "主板在整机中承载解码、伺服与音频电路，把激光头读出的数据流还原为视频与音频输出。"
      },
      "transform": {
        "translation": [0.0, 0.0, 0.0],
        "rotation": [0.0, 0.0, 0.0, 1.0],
        "scale": [1.0, 1.0, 1.0]
      },
      "parent": "whole",
      "children": [],
      "components": ["decoder_ic", "servo_ic", "audio_ic"],
      "annotations": ["mainboard_role", "decode_flow", "mpeg2_flow"],
      "mesh_ref": "assemblies/mainboard.gltf"
    }
  ],
  "components": [
    {
      "id": "decoder_ic",
      "name": "解码 IC",
      "type": "ic",
      "role": {
        "zh": "解码 IC 在整机中解压 MPEG-2 视频码流与数字音频，还原为可输出的视频与音频信号。"
      },
      "assembly": "mainboard",
      "annotations": ["decoder_ic_role"]
    },
    {
      "id": "servo_ic",
      "name": "伺服控制 IC",
      "type": "ic",
      "role": {
        "zh": "伺服控制 IC 在整机中控制主轴转速与激光头寻道，维持读盘的聚焦与循迹稳定。"
      },
      "assembly": "mainboard",
      "annotations": ["servo_ic_role"]
    },
    {
      "id": "audio_ic",
      "name": "音频解码 IC",
      "type": "ic",
      "role": {
        "zh": "音频解码 IC 在整机中解出数字音频码流，输出多声道或立体声伴音。"
      },
      "assembly": "mainboard",
      "annotations": ["audio_ic_role"]
    },
    {
      "id": "laser_diode",
      "name": "激光二极管",
      "type": "diode",
      "role": {
        "zh": "激光二极管在整机中发射红色激光，经聚焦后照射光盘数据面，是读盘的光源。"
      },
      "assembly": "laser_pickup",
      "annotations": ["laser_diode_role"]
    }
  ],
  "runtime": {
    "emulator": "none",
    "version": "1.0.0",
    "system": "DVD 播放机（静态展示）",
    "media_hint": "none",
    "bios_required": false,
    "bios_guide_url": null,
    "output_sinks": [
      {
        "id": "crt_display_0",
        "surface": "crt_display",
        "type": "video",
        "format": "rgba8"
      },
      {
        "id": "speaker_0",
        "surface": "speaker",
        "type": "audio",
        "format": "pcm16"
      }
    ],
    "input_map": {
      "power": {
        "map": "keyboard",
        "key": "KEY_P"
      },
      "play": {
        "map": "keyboard",
        "key": "KEY_ENTER"
      },
      "stop": {
        "map": "keyboard",
        "key": "KEY_S"
      },
      "pause": {
        "map": "keyboard",
        "key": "KEY_SPACE"
      },
      "fast_forward": {
        "map": "keyboard",
        "key": "KEY_F"
      },
      "rewind": {
        "map": "keyboard",
        "key": "KEY_B"
      },
      "eject": {
        "map": "keyboard",
        "key": "KEY_E"
      },
      "demo_next": {
        "map": "keyboard",
        "key": "KEY_DOWN"
      }
    }
  }
}
