{
  "annotations": [
    {
      "id": "apple_ii_role",
      "type": "role",
      "target": "apple_ii",
      "text": "Apple II 整机，一台 1977 年发布的 8 位个人计算机，由机箱、电源、键盘、主板、扬声器与 Disk II 软驱组成，是博物馆垂直切片展示的核心设备。",
      "sources": []
    },
    {
      "id": "case_role",
      "type": "role",
      "target": "case",
      "text": "机箱在整机中负责包覆并保护内部电路与机械部件，同时承载键盘、铭牌与提手，构成整机的外观壳体。",
      "sources": []
    },
    {
      "id": "lid_role",
      "type": "role",
      "target": "lid",
      "text": "上盖在整机中作为机箱的顶盖，可向后掀起开盖，暴露整机内部结构供观察与拆解。",
      "sources": []
    },
    {
      "id": "bottom_role",
      "type": "role",
      "target": "bottom",
      "text": "底壳在整机中作为机箱底座，固定主板、电源与键盘，并承载机脚与序列号铭牌。",
      "sources": []
    },
    {
      "id": "badge_role",
      "type": "role",
      "target": "badge",
      "text": "铭牌在整机中展示彩虹苹果标志与 Apple II 字样，标识整机的品牌与型号。",
      "sources": []
    },
    {
      "id": "handle_role",
      "type": "role",
      "target": "handle",
      "text": "提手在整机中位于顶盖后方，供使用者提起与搬运整机。",
      "sources": []
    },
    {
      "id": "vent_grille_role",
      "type": "role",
      "target": "vent_grille",
      "text": "通风栅格在整机中位于机箱后部，为整机内部提供散热通风的气流通道。",
      "sources": []
    },
    {
      "id": "power_supply_role",
      "type": "role",
      "target": "power_supply",
      "text": "开关电源模块在整机中负责把市电转换为 +5V、-5.2V、+11.8V、-12V 多路直流电，为整机各部件稳定供电。",
      "sources": []
    },
    {
      "id": "psu_case_role",
      "type": "role",
      "target": "psu_case",
      "text": "金属屏蔽盒在整机中包覆电源电路，隔离高频开关噪声并保护内部高压部件。",
      "sources": []
    },
    {
      "id": "power_switch_role",
      "type": "role",
      "target": "power_switch",
      "text": "电源开关在整机中控制整机的通断电，位于电源后板，由用户拨动操作。",
      "sources": []
    },
    {
      "id": "psu_board_role",
      "type": "role",
      "target": "psu_board",
      "text": "电源板在整机中承载变压器、整流与稳压器件，完成市电到多路直流的变换。",
      "sources": []
    },
    {
      "id": "power_cord_role",
      "type": "role",
      "target": "power_cord",
      "text": "电源线在整机中把市电引入电源模块，为整机供电提供外部接口。",
      "sources": []
    },
    {
      "id": "transformer_role",
      "type": "role",
      "target": "transformer",
      "text": "变压器在整机中实现输入电压的隔离与变换，是开关电源的能量转换核心。",
      "sources": []
    },
    {
      "id": "rectifier_role",
      "type": "role",
      "target": "rectifier",
      "text": "整流器件在整机中把交流电压转换为脉动直流，为后续稳压提供基础。",
      "sources": []
    },
    {
      "id": "regulator_role",
      "type": "role",
      "target": "regulator",
      "text": "稳压器件在整机中把脉动直流稳定为多路精确电压，保障整机供电质量。",
      "sources": []
    },
    {
      "id": "output_harness_role",
      "type": "role",
      "target": "output_harness",
      "text": "输出线束在整机中把电源板的各路电压引到主板与驱动器，完成整机内部的供电分配。",
      "sources": []
    },
    {
      "id": "keyboard_role",
      "type": "role",
      "target": "keyboard",
      "text": "键盘组件在整机中负责把用户的按键动作编码为数据，经主板送入处理器，是整机的主要输入设备。",
      "sources": []
    },
    {
      "id": "keycap_array_role",
      "type": "role",
      "target": "keycap_array",
      "text": "键帽矩阵在整机中覆盖在键开关之上，标注字符并供用户按压，是键盘的触按表面。",
      "sources": []
    },
    {
      "id": "keyswitch_array_role",
      "type": "role",
      "target": "keyswitch_array",
      "text": "键开关阵列在整机中把每次按压转换为通断信号，是键盘产生按键事件的核心机构。",
      "sources": []
    },
    {
      "id": "keyboard_pcb_role",
      "type": "role",
      "target": "keyboard_pcb",
      "text": "键盘电路板在整机中承载键开关与编码器，把开关通断转换为处理器可读的数据。",
      "sources": []
    },
    {
      "id": "key_encoder_role",
      "type": "role",
      "target": "key_encoder",
      "text": "键盘编码器在整机中把键开关矩阵的扫描结果编码为按键数据，供处理器读取。",
      "sources": []
    },
    {
      "id": "mainboard_role",
      "type": "role",
      "target": "mainboard",
      "text": "主板在整机中承载处理器、内存、只读存储器、视频电路与八个扩展槽，是整机的核心电路板。",
      "sources": []
    },
    {
      "id": "rom_section_role",
      "type": "role",
      "target": "rom_section",
      "text": "ROM 区在整机中存放开机即用的固件程序，包括系统监控、BASIC 解释器与字符字形。",
      "sources": []
    },
    {
      "id": "ram_section_role",
      "type": "role",
      "target": "ram_section",
      "text": "RAM 区在整机中暂存运行时的程序与数据，是处理器高速读写的工作内存。",
      "sources": []
    },
    {
      "id": "ram_row_c_role",
      "type": "role",
      "target": "ram_row_c",
      "text": "内存行 C 在整机中是 RAM 区第一行内存插座，安装动态内存芯片以扩充工作内存容量。",
      "sources": []
    },
    {
      "id": "ram_row_d_role",
      "type": "role",
      "target": "ram_row_d",
      "text": "内存行 D 在整机中是 RAM 区第二行内存插座，与其余两行共同构成工作内存阵列。",
      "sources": []
    },
    {
      "id": "ram_row_e_role",
      "type": "role",
      "target": "ram_row_e",
      "text": "内存行 E 在整机中是 RAM 区第三行内存插座，与其余两行共同构成工作内存阵列。",
      "sources": []
    },
    {
      "id": "clock_circuit_role",
      "type": "role",
      "target": "clock_circuit",
      "text": "时钟电路在整机中由晶体分频产生 1.023 MHz 处理器时钟与视频时序基准。",
      "sources": []
    },
    {
      "id": "video_section_role",
      "type": "role",
      "target": "video_section",
      "text": "视频电路在整机中把显存内容合成为 NTSC 复合视频信号，供外接监视器或电视显示。",
      "sources": []
    },
    {
      "id": "video_ttl_group_role",
      "type": "role",
      "target": "video_ttl_group",
      "text": "视频 TTL 芯片组在整机中执行视频时序与字符生成逻辑，驱动显存到画面的转换。",
      "sources": []
    },
    {
      "id": "video_connector_role",
      "type": "role",
      "target": "video_connector",
      "text": "视频输出座在整机中提供 RCA 复合视频接口，把画面信号送往外接显示设备。",
      "sources": []
    },
    {
      "id": "io_section_role",
      "type": "role",
      "target": "io_section",
      "text": "I/O 接口区在整机中提供磁带、游戏手柄与电源等外部接口，连接整机与外部设备。",
      "sources": []
    },
    {
      "id": "cassette_ports_role",
      "type": "role",
      "target": "cassette_ports",
      "text": "磁带接口在整机中提供 1200 波特磁带输入输出，支持程序与数据的音频式存取。",
      "sources": []
    },
    {
      "id": "game_port_role",
      "type": "role",
      "target": "game_port",
      "text": "游戏接口在整机中连接摇杆与手柄，接收模拟轴与按钮的输入信号。",
      "sources": []
    },
    {
      "id": "power_connector_role",
      "type": "role",
      "target": "power_connector",
      "text": "电源连接器在整机中把电源模块的直流输出引入主板，为电路板供电。",
      "sources": []
    },
    {
      "id": "slot_array_role",
      "type": "role",
      "target": "slot_array",
      "text": "扩展槽阵列在整机中提供八个 50 针开放式外设插槽，是整机可扩展性的根基。",
      "sources": []
    },
    {
      "id": "bus_logic_role",
      "type": "role",
      "target": "bus_logic",
      "text": "总线逻辑在整机中负责地址译码与数据总线控制，协调处理器与各部件之间的数据交换。",
      "sources": []
    },
    {
      "id": "decoupling_group_role",
      "type": "role",
      "target": "decoupling_group",
      "text": "去耦元件组在整机中由电容与电阻组成，平滑电源纹波并抑制高频噪声，稳定整机供电。",
      "sources": []
    },
    {
      "id": "speaker_role",
      "type": "role",
      "target": "speaker",
      "text": "扬声器在整机中负责把 1 位音频信号转换为声音，是整机发出提示音与游戏音效的发声部件。",
      "sources": []
    },
    {
      "id": "disk_ii_role",
      "type": "role",
      "target": "disk_ii",
      "text": "Disk II 软驱在整机中负责读写 5.25 英寸软盘，为整机提供 140 KB 的磁介质存储能力。",
      "sources": []
    },
    {
      "id": "disk_mech_role",
      "type": "role",
      "target": "disk_mech",
      "text": "盘体机构在整机中固定并旋转软盘盘片，是软驱读写数据的主体机械结构。",
      "sources": []
    },
    {
      "id": "disk_platter_role",
      "type": "role",
      "target": "disk_platter",
      "text": "盘片在整机中是存储数据的磁介质圆片，由驱动电机带动旋转供磁头读写。",
      "sources": []
    },
    {
      "id": "spindle_role",
      "type": "role",
      "target": "spindle",
      "text": "主轴在整机中夹持并驱动盘片旋转，保证盘片与磁头之间的稳定相对运动。",
      "sources": []
    },
    {
      "id": "read_write_head_role",
      "type": "role",
      "target": "read_write_head",
      "text": "磁头组件在整机中执行软盘的读取与写入，通过电磁感应读写盘片上的数据。",
      "sources": []
    },
    {
      "id": "head_coil_role",
      "type": "role",
      "target": "head_coil",
      "text": "磁头线圈在整机中是磁头组件的电磁换能器，实现电信号与磁信号之间的相互转换。",
      "sources": []
    },
    {
      "id": "drive_motor_role",
      "type": "role",
      "target": "drive_motor",
      "text": "驱动电机在整机中带动软盘盘片匀速旋转，为磁头读写提供恒定的转速。",
      "sources": []
    },
    {
      "id": "disk_door_role",
      "type": "role",
      "target": "disk_door",
      "text": "软驱门开关在整机中检测磁盘是否插入到位，并把状态告知磁盘控制器。",
      "sources": []
    },
    {
      "id": "slot_0_role",
      "type": "role",
      "target": "slot_0",
      "text": "扩展槽 0 在整机中是第 0 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_1_role",
      "type": "role",
      "target": "slot_1",
      "text": "扩展槽 1 在整机中是第 1 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_2_role",
      "type": "role",
      "target": "slot_2",
      "text": "扩展槽 2 在整机中是第 2 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_3_role",
      "type": "role",
      "target": "slot_3",
      "text": "扩展槽 3 在整机中是第 3 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_4_role",
      "type": "role",
      "target": "slot_4",
      "text": "扩展槽 4 在整机中是第 4 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_5_role",
      "type": "role",
      "target": "slot_5",
      "text": "扩展槽 5 在整机中是第 5 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_6_role",
      "type": "role",
      "target": "slot_6",
      "text": "扩展槽 6 在整机中是第 6 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "slot_7_role",
      "type": "role",
      "target": "slot_7",
      "text": "扩展槽 7 在整机中是第 7 号 50 针外设插槽，可插入磁盘控制器、语言卡等扩展卡，扩展整机功能。",
      "sources": []
    },
    {
      "id": "cpu_role",
      "type": "role",
      "target": "cpu",
      "text": "6502 中央处理器在整机中负责取指、译码与执行指令，是整机的运算与控制核心。",
      "sources": []
    },
    {
      "id": "rom_monitor_role",
      "type": "role",
      "target": "rom_monitor",
      "text": "监控 ROM 在整机中提供系统监控程序，负责开机复位后的自检与命令行交互。",
      "sources": []
    },
    {
      "id": "rom_basic_role",
      "type": "role",
      "target": "rom_basic",
      "text": "Integer BASIC ROM 在整机中存放整数 BASIC 解释器，是开机即可编程的语言环境。",
      "sources": []
    },
    {
      "id": "chargen_role",
      "type": "role",
      "target": "chargen",
      "text": "字符发生器 ROM 在整机中存放字符点阵字形，供视频电路把字符码转换为显示图案。",
      "sources": []
    },
    {
      "id": "crystal_role",
      "type": "role",
      "target": "crystal",
      "text": "14.318 MHz 晶振在整机中产生基准频率，经分频得到处理器与视频所需的时钟信号。",
      "sources": []
    },
    {
      "id": "video_ttl_chip_role",
      "type": "role",
      "target": "video_ttl_chip",
      "text": "视频逻辑芯片在整机中执行视频时序逻辑，是视频 TTL 芯片组中的代表芯片。",
      "sources": []
    },
    {
      "id": "ram_chip_role",
      "type": "role",
      "target": "ram_chip",
      "text": "4116 动态内存芯片在整机中提供 16 Kbit 存储单元，是构成工作内存的基本器件。",
      "sources": []
    },
    {
      "id": "disk_controller_role",
      "type": "role",
      "target": "disk_controller",
      "text": "Disk II 控制器在整机中连接软驱与主板，解释磁盘读写命令并控制盘片操作。",
      "sources": []
    },
    {
      "id": "regulator_ic_role",
      "type": "role",
      "target": "regulator_ic",
      "text": "稳压集成电路在整机中稳定输出各路直流电压，抑制电压波动对整机的干扰。",
      "sources": []
    },
    {
      "id": "key_switch_role",
      "type": "role",
      "target": "key_switch",
      "text": "键开关在整机中把一次按键按压转换为电信号通断，是键盘产生输入的基础器件。",
      "sources": []
    },
    {
      "id": "keycap_role",
      "type": "role",
      "target": "keycap",
      "text": "键帽在整机中覆盖于键开关顶部并标注字符，是用户手指接触的按键盘面。",
      "sources": []
    },
    {
      "id": "speaker_driver_role",
      "type": "role",
      "target": "speaker_driver",
      "text": "扬声器驱动在整机中放大 1 位音频信号并推动扬声器发声，完成整机的音频输出。",
      "sources": []
    },
    {
      "id": "boot_flow",
      "type": "flow",
      "target": "apple_ii",
      "text": "开机自检流程：按下电源开关，电源输出多路直流；6502 从复位向量读取监控程序入口，执行 ROM 自检并进入 ] 提示符；若检测到引导卡则经扩展槽启动磁盘系统。",
      "sources": []
    },
    {
      "id": "display_flow",
      "type": "flow",
      "target": "video_section",
      "text": "显示刷新流程：处理器与视频电路交替访问显存；字符发生器把字符码转为点阵；视频 TTL 逻辑合成行场同步；NTSC 复合信号经视频输出座送到外接监视器逐行显示。",
      "sources": []
    },
    {
      "id": "keyboard_flow",
      "type": "flow",
      "target": "keyboard",
      "text": "键盘输入流程：用户按下键帽，键开关闭合；键盘编码器扫描开关矩阵并编码为按键数据；数据经主板数据总线送入 6502 处理器完成输入。",
      "sources": []
    },
    {
      "id": "disk_read_anim",
      "type": "anim",
      "target": "disk_ii",
      "text": "磁盘读写动画：收到读写命令后触发；驱动电机带动盘片匀速旋转，磁头组件沿径向寻道至目标磁道，磁头线圈完成读写；单次全程约 2 秒，结束后磁头回位并停止电机。",
      "sources": []
    },
    {
      "id": "video_scan_anim",
